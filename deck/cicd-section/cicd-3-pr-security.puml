@startuml
!include _cicd.iuml
left to right direction
title PR stage · security workflows run beside Quality and report their findings
skinparam nodesep 14
skinparam ranksep 70
skinparam ArrowFontSize 20

rectangle "Pull request\n+ push to\ndev / main" as PR

rectangle "<b>REPORTS · SAST</b>\nCodeQL ×3: JS/TS · Python · Actions\n<size:20>security-extended · also weekly Monday</size>" <<report>> as CQ
rectangle "<b>REPORTS · Secrets</b>\nGitleaks v8.30.1 · full git history\n<size:20>default rules + 2 exact allowlists</size>" <<report>> as GL
rectangle "<b>REPORTS · Containers + SBOM</b>\nTrivy v0.70.0 · runtime + web images\n<size:20>fails job on HIGH / CRITICAL</size>" <<report>> as TI
rectangle "<b>REPORTS · IaC</b>\nTrivy config · Terraform + Dockerfiles\n<size:20>8 exact exceptions, expire 31 Oct</size>" <<report>> as IAC
rectangle "<b>REPORTS · Secrets + SCA</b>\nGitGuardian app · Dependabot\n<size:20>PR status · alerts · monthly PRs</size>" <<report>> as GG

artifact "SARIF results\nper language" as A1
artifact "gitleaks.sarif\n(redacted)" as A2
artifact "runtime/web-sbom.cdx.json\nruntime/web-vulnerabilities.txt" as A3
artifact "iac-full.json" as A4

database "Security tab ›\nCode scanning\n<size:20>CodeQL + Gitleaks</size>" as SEC
folder "Actions artifacts\n<size:20>30 days</size>" as ART
database "PR checks ·\nDependabot alerts" as PRS

PR --> CQ
PR --> GL
PR --> TI : path\nfilter
PR --> IAC : path\nfilter
PR --> GG
CQ --> A1
GL --> A2
TI --> A3
IAC --> A4
A1 --> SEC
A2 --> SEC
A2 --> ART
A3 --> ART
A4 --> ART
GG --> PRS
@enduml
