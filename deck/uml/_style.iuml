' Rewind UML look, derived from FlickPond _style.iuml (same fonts, line weights, note yellow).
!$IFACE = "#DBEAFE"
!$IFACE_LINE = "#2563EB"
!$IMPL = "#ECFDF5"
!$IMPL_LINE = "#059669"
!$MODULE = "#F1F5F9"
!$MODULE_LINE = "#64748B"
!$EXT = "#FEF3C7"
!$EXT_LINE = "#D97706"
skinparam dpi 110
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 15
skinparam defaultFontColor #0f172a
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam ArrowColor #475569
skinparam ArrowThickness 1.4
skinparam ArrowFontSize 13
skinparam ArrowFontColor #334155
skinparam BackgroundColor transparent
skinparam LegendBackgroundColor #ffffff
skinparam LegendBorderColor #94a3b8
skinparam LegendFontSize 13
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #d6c27a
skinparam NoteFontSize 13
skinparam PackageBorderColor #64748B
skinparam PackageBackgroundColor #ffffff
skinparam PackageFontStyle bold
skinparam ClassBackgroundColor #ffffff
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #F1F5F9
skinparam ClassAttributeFontSize 13
skinparam ClassStereotypeFontSize 12
skinparam classAttributeIconSize 0
skinparam ComponentBackgroundColor #ffffff
skinparam ComponentBorderColor #334155
skinparam NodeBackgroundColor #ffffff
skinparam NodeBorderColor #334155
skinparam DatabaseBackgroundColor #ffffff
skinparam ParticipantBackgroundColor #ffffff
skinparam ParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #94a3b8
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceMessageAlign left
skinparam StateBackgroundColor #ffffff
skinparam StateBorderColor #334155
skinparam EntityBackgroundColor #ffffff
skinparam EntityBorderColor #334155
hide circle
hide empty members

' SAD + ARCH slide adaptation, additive to the FlickPond baseline.
!$SAD = "#EEE7F3"
!$SAD_LINE = "#75528F"
!$CREAM = "#F5F2E9"
!$NAVY = "#14202B"
skinparam dpi 96
skinparam BackgroundColor #FFFFFF
skinparam defaultFontSize 20
skinparam defaultFontColor #14202B
skinparam titleFontSize 24
skinparam ArrowFontSize 19
skinparam ArrowColor #596473
skinparam NoteFontSize 19
skinparam LegendFontSize 19
skinparam ClassAttributeFontSize 19
skinparam ClassStereotypeFontSize 18
skinparam ClassHeaderBackgroundColor #F5F2E9
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #C7BCA7
skinparam ParticipantBackgroundColor #F5F2E9
skinparam SequenceGroupBackgroundColor #F5F2E9
skinparam SequenceGroupHeaderFontSize 19
skinparam SequenceLifeLineBorderColor #B8ACBF
skinparam SequenceGroupBorderColor #A99BB2
skinparam StateBackgroundColor #F5F2E9
skinparam StateBorderColor #75528F
skinparam NoteBackgroundColor #FCF7E7
skinparam NoteBorderColor #CBBE96
skinparam Padding 8
skinparam nodesep 30
skinparam ranksep 35
