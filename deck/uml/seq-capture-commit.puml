!include _style.iuml
title Design sequence · UC06 Commit the allowance and contribution
hide footbox
autonumber
skinparam Padding 0
skinparam sequence {
 MessageSpacing 0
 ParticipantPadding 5
 BoxPadding 3
}
skinparam ParticipantFontSize 19
skinparam SequenceGroupHeaderFontSize 19
