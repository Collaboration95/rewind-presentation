from pathlib import Path
import re,json,html,shutil,subprocess
D=Path(__file__).resolve().parent
P=D.parent
(D/'assets').mkdir(exist_ok=True); (D/'out').mkdir(exist_ok=True); (D/'clips').mkdir(exist_ok=True)
FRAMEWORK=Path('/Users/speedpowermac/Documents/projects/CODE_MAIN/NUS/dc2-rescue/project-documentation/presentation/site/deck.html').read_text()
basecss=re.search(r'<style>(.*?)</style>',FRAMEWORK,re.S).group(1)
basejs=re.findall(r'<script>(.*?)</script>',FRAMEWORK,re.S)[-1]
manifest=json.loads((P/'pipeline-run-40344230832/security/release-manifest.json').read_text())
slides=[]
def esc(s):return html.escape(str(s))
def table(head,rows,cls=''):
 return '<table class="data '+cls+'"><thead><tr>'+''.join('<th>'+c+'</th>' for c in head)+'</tr></thead><tbody>'+''.join('<tr>'+''.join('<td>'+c+'</td>' for c in r)+'</tr>' for r in rows)+'</tbody></table>'
def points(*items):return ''.join('<p><b>'+a+'</b> '+b+'</p>' for a,b in items)
def fig(id,title):
 return f'<figure class="figure diagram" data-figure="{id}"><figcaption>{esc(title)}</figcaption><img src="uml/{id}.svg" alt="{esc(title)}" onload="this.parentElement.classList.add(\'loaded\')" onerror="this.style.display=\'none\'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>{esc(title)}</strong><code>uml/{id}.svg</code></div></figure>'
def split(left,right,cls=''):
 return f'<div class="split {cls}">{left}<div class="explain">{right}</div></div>'
def block(content,title=''):
 return '<div class="figure">'+('<div class="figuretitle">'+title+'</div>' if title else '')+content+'</div>'
def add(id,sec,tag,title,body,secs,say,transition,refs,source,script,kind='main',extra=''):
 slides.append(dict(id=id,sec=sec,tag=tag,title=title,body=body,secs=secs,say=say,transition=transition,refs=refs,source=source,script=script,kind=kind,extra=extra))
def chart_img(src,title):
 target=D/'assets'/Path(src).name
 if (P/src).exists():shutil.copy2(P/src,target)
 return '<figure class="figure chart"><figcaption>'+title+'</figcaption><img src="assets/'+target.name+'" alt="'+title+'"></figure>'
# Main narrative: 1–3, project management.
add('s1',1,'PM','A month of moments. One film.',
 '<div class="cover-word">Rewind<span>↶</span></div><div class="cover-sub">Small private groups. Sealed moments. A shared reveal.</div><div class="cover-loop"><span>Contribute</span><i>→</i><span>Seal</span><i>→</i><span>Compile</span><i>→</i><span>Watch</span></div><div class="cover-meta">SWE5006 · TEAM 14 · 27 OCTOBER 2026<br>Gopal Guruprasath</div>',15,
 ['Rewind gives a small group one shared film from a month of everyday moments.'], 'First, the problem and the product boundary.', ['B10'],'BRIEF-SHARED.md · 27 Oct 2026',
 'Good afternoon. I am Gopal Guruprasath, presenting Rewind for SWE5006 Team 14. Rewind turns a month of everyday contributions into one private film for a small group. I will connect the product to our design, tests and delivery pipeline, then show the complete journey.',extra='cover')
add('s2',1,'PM','Everyday moments need a shared reason to return.',
 split(block('<div class="product-loop"><div><em>01</em><h2>Contribute</h2><p>Photo or video<br>2–10 members</p></div><div><em>02</em><h2>Seal</h2><p>Private until reveal<br>28-day cycle</p></div><div><em>03</em><h2>Watch</h2><p>One group film<br>24-hour premiere</p></div></div><div class="rule">5 moments / 30 seconds per member each week</div>','Product view · private-group journey'),points(('Problem.','Photos disappear into busy chats; shared memories become scattered.'),('Scope.','Accounts, invitation, capture, chat, reminders, film and Archive in a web/PWA product.'),('Value.','A bounded contribution habit leads to one shared reveal.'))),55,
 ['The problem is fragmented memories in busy group chats.','The product uses small groups, a 28-day cycle and weekly contribution limits.','Photo and video both stay; the iPhone experience is the Home Screen app.'],'The four sprints show how we delivered this boundary.', ['B1','B10'],'audit/F1-system-demo.md §1 · product rules',
 'Our business problem is simple: people already capture moments, but the moments disappear inside busy chats and camera rolls. A group has no common point at which to look back together. Rewind adds that point. Two to ten members contribute photos or short videos, and the contributions remain sealed until a twenty-eight-day cycle closes. Each member has five moments and thirty seconds per week. The limit keeps the contribution small enough to become a habit. At the end, the group receives one film and a twenty-four-hour premiere before the film remains in Archive. Our scope is the real-account web and PWA journey: identity, private groups, invitations, capture, chat, reminders and films. That is the boundary used in the design and in the demonstration.')
# Compact record-based charts, with labels designed for the stage.
velocity='<svg viewBox="0 0 700 184" aria-label="Velocity: issues closed by sprint"><text x="10" y="24">Velocity · issues closed in each sprint window</text>'
for i,(lab,n) in enumerate(zip(['S0','S1','S2','S3'],[44,100,145,30])):
 x=72+i*154; h=n*.65
 velocity+=f'<rect x="{x}" y="{150-h}" width="78" height="{h}" fill="#247b72"/><text x="{x+39}" y="{138-h}" text-anchor="middle">{n}</text><text x="{x+39}" y="178" text-anchor="middle">{lab}</text>'
velocity+='</svg>'
add('s3',1,'PM','Four sprints delivered the hosted private-group journey.',
 '<div class="pm-grid"><div>'+table(['Sprint','Milestone'],[['0 · 1–12 Sep','Runtime foundation'],['1 · 13–26 Sep','Integrated capture-to-film'],['2 · 27 Sep–10 Oct','Real accounts · S3 · PostgreSQL · Cognito'],['3 · 11–24 Oct','Stability · recovery · regression tests']])+block(velocity)+ '</div><div>'+points(('Team · equal effort.','Nguyen Kim Long · Gopal Guruprasath · Jiang Jiayu · Phan Mai Tan Loi · Sang Haoxiang.<br><strong>20% each · agreed split.</strong>'),('Done.','Outcome checked + fast tests + green Quality + merge to dev. Batch reviews resolve blocking findings.'),('Ceremonies.','Project planning; Sprint Planning and Review each sprint.'),('Retro → next sprint.','Integration gaps in S1 → real adapters in S2; stale state in S2 → interaction tests in S3.'))+'</div></div><div class="status-strip"><b>26 OCT · OPEN</b> #587 focused runner · #588 chat labels · #527 Safari/PWA integration · #362 report assembly <span>Full delivery register → B10</span></div>',140,
 ['The four milestones move from a runnable skeleton to real accounts and stabilisation.','Each of our five members has an agreed twenty-percent effort share.','Planning and reviews happened each sprint; retrospective actions changed the next sprint’s checks.'],'The use cases now give that scope a formal boundary.',['B10'],'records/TEAM.md · AGILE.md · charts/velocity.png · open issues checked 26 Oct',
 'We used four sprints with zero-based names. Sprint zero built the runnable foundation. Sprint one integrated capture, the cycle and Archive. Sprint two established the real-account product, private media and hosted integration. Sprint three concentrated on stability, recovery and behavioural regression tests. The velocity chart counts issues closed inside each sprint window: forty-four, one hundred, one hundred and forty-five, then thirty. It is a delivery-count view. The backup has the event-replayed burndowns, including scope changes. For example, Sprint two grew from nine issues in scope to one hundred and thirty-five, while Sprint three ended with five open in its milestone. We retained that scope movement in the records.\n\nOur team is Nguyen Kim Long, Gopal Guruprasath, Jiang Jiayu, Phan Mai Tan Loi and Sang Haoxiang. Effort is split equally at twenty percent each. The agreed plan is ten person-days per member. I coordinated the product and integration work; the team responsibilities span requirements, server integration, client experience and quality support.\n\nOur Definition of Done is outcome checked in the cheapest environment that exercises it, fast tests passing, a green aggregate Quality check, and merge to dev. Overnight batches also get a review pass with blocking findings fixed. Project planning, Sprint Planning and Sprint Review were held. The useful retrospective chain is visible in the implementation: Sprint one exposed integration gaps, so Sprint two exercised real adapters; Sprint two exposed stale state and incomplete downloads, so Sprint three added whole-interaction and pagination checks.\n\nThis status is dated twenty-six October. The remaining presentation-relevant issues cover focused runner selection, emoji and calendar labels, the hosted Safari/PWA integration check, and report assembly. The complete seven-item delivery register is in the backup. We now move from the product boundary to the analysis models.')
# Analysis and design.
add('s4',2,'SAD','Fourteen use cases follow one private-group journey.',split(fig('uc-model','Use case view · UC01–UC14 · private-group journey'),points(('Actors.','Members contribute and watch; group owners manage membership and settings.'),('System boundary.','Cognito, S3, web push and the scheduler participate through explicit interfaces.'),('Critical path.','CU-B joins UC07 cycle closure to UC08 film compilation and reveal.'))),33,
 ['Read the human goals inside the boundary before following implementation details.','CU-B is close cycle, compile and release the group film.'],'The logical view shows where those responsibilities live.',['B1','B3'],'audit/B1-analysis.md · uc-model',
 'The use case view starts with user goals rather than code. A member joins a private group, contributes, chats and watches; the owner also manages membership and settings. The boundary makes the secondary systems explicit: identity, object storage, web push and scheduled time. For detailed design I will follow CU-B: close the cycle, compile the film and release it. That path connects UC07 and UC08 and crosses persistence, background work and media processing.')
add('s5',2,'SAD','One Node application keeps rules close to transactions.',split(fig('arch-logical','Logical view · private-group application and adapters'),points(('Monolith.','One Node/TypeScript application owns policy and transaction boundaries.'),('Persistence.','Hosted PostgreSQL stores durable group, cycle and job state; S3 holds private media.'),('Adapters.','Cognito identity, media storage and browser capture sit behind named interfaces.'))),39,
 ['We chose a modular monolith because the private-group rules share transactions.','PostgreSQL stores durable state and S3 stores media.','Interfaces isolate identity, storage and capture differences.'],'Now map the analysis responsibilities onto that implementation.',['B4','B5','B9'],'audit/B1-analysis.md · B2-design.md · ADR-0003',
 'The principal architecture decision is a modular monolith. The application is small enough that splitting membership, contributions and cycles into separate services would add coordination without improving this workflow. Keeping the rules near a transaction makes acceptance and cycle transitions easier to reason about. Hosted PostgreSQL gives us durable relational state, while private S3 objects carry the media. Cognito supplies the web identity flow. Adapters keep those external protocols outside the domain decisions. This logical view shows responsibilities and dependencies; the deployment view later will show where these elements run.')
add('s6',2,'SAD','Analysis responsibilities become named implementation modules.',split(fig('a2d-cycle','Analysis → design view · CU-B close, compile, reveal'),points(('Analysis.','Boundary objects receive interaction; controls coordinate the use case; entities retain business state.'),('Design.','The scheduler, lifecycle and compilation modules implement those responsibilities.'),('Trace.','Cycles, media jobs and frozen compilation inputs provide the persistent record.'))),45,
 ['The analysis model names responsibilities before implementation.','The design model maps those responsibilities to real modules and tables.','Function modules are labelled as modules, not invented classes.'],'The hardest design problem is safely repeating this background work.',['B1','B2'],'audit/B1-analysis.md · CU-B mapping',
 'The left side of this mapping is analysis. A boundary receives interaction, a control coordinates the use case, and entities represent the state the business needs to retain. Those are responsibilities. On the right, we refine them into implementation names. The scheduler finds work, lifecycle owns the cycle transition, compilation prepares and finalises the film, and the database retains cycles, jobs and frozen inputs. The analysis classes remain available in backup B1. In the design diagrams, a collection of functions is shown as a module. A class symbol is reserved for an actual class. That keeps the model traceable to the code a maintainer will open.')
add('s7',2,'SDP','Durable claims keep repeated cycle work safe.',split(fig('class-cycle','Design class view · CU-B · durable job and claim roles'),points(('Problem.','Ticks repeat; a worker may stop or complete after its claim expires.'),('Candidates.','Polling alone; a hierarchy of State or Command objects; persisted state with durable jobs.'),('Chosen.','Persisted lifecycle + one durable job + lease/generation checks at finalisation.'))),54,
 ['Polling finds work but does not make repeated execution safe.','We compared polling alone and object hierarchies with persisted state and durable jobs.','The implementation uses durable claims and rejects stale completion.'],'The sequence shows where those checks happen.',['B2','B7','B8','B9'],'audit/B1-analysis.md · B2-design.md · server/src/jobs/compilation.ts',
 'The design problem is repeated execution. A scheduler tick can repeat, a process can stop, and an old worker can finish after another worker has claimed the same work. Polling alone only tells us that something needs attention. We considered a hierarchy of State objects, separate Command objects, and persistent state with a durable job. The chosen design uses persisted lifecycle state, a durable compilation job and a claim that includes lease and generation information. The class view makes those roles visible on real modules and stored entities. A worker can do expensive media work outside a long database transaction, then prove it still owns the claim before publishing. The result is a precise completion rule that survives retries and process restarts.')
add('s8',2,'SAD','A repeated tick reuses work and fences stale completion.',split(fig('seq-cycle','Sequence view · CU-B · close cycle → compile → reveal'),points(('Close.','The lifecycle transition creates the successor and queues compilation atomically.'),('Compile.','The worker claims durable work and renders the frozen input set.'),('Finalise.','A current claim publishes the film; duplicate or stale paths follow the alternatives.'))),57,
 ['Follow close, claim, render and finalise in that order.','The alternatives show duplicate ticks and stale workers.','A retry reuses durable state instead of creating a second film.'],'The schema explains what makes those decisions durable.',['B2','B3'],'audit/B1-analysis.md · seq-cycle · jobs/worker.ts',
 'Read the sequence from the numbered messages. The scheduler identifies the ended cycle and the lifecycle module performs the closing transition. That transaction also makes the next cycle available and stages the compilation work. The worker then claims the durable job and renders the frozen input set. Rendering happens outside the database transaction because it can take seconds. At finalisation, the code checks that the claim still belongs to this worker and generation. The alternative frames matter as much as the happy path: a repeated tick reuses existing work, and a stale worker cannot publish over the current result. The loop describes retry around the retained job. The arrows explain how the safety rule is enforced, while the schema explains what survives a restart.')
add('s9',2,'SAD','Keys preserve membership and the film’s exact input set.',split(fig('er-core','ER view · CU-B and private-group membership · PostgreSQL'),points(('Access.','Membership relates an account to a group and its role.'),('History.','Cycles own contributions; media jobs retain processing state.'),('Reproducibility.','Compilation inputs freeze which media belongs to a film.'),('Integrity.','Primary keys, foreign keys and uniqueness enforce the relationships.'))),72,
 ['Membership is a relation used by access decisions.','Cycles own contributions and durable media jobs.','Frozen compilation inputs preserve the film’s exact input set.'],'Tests exercise those rules through their real boundaries.',['B4','B9'],'audit/B2-design.md · er-core · PostgreSQL schema',
 'This is the database schema for the same use case, with the access relationships alongside it. Start at the group and membership relation. It answers who belongs to the group and in which role. A group has cycles; a cycle has contributions; the processing jobs retain what must happen to the media. The compilation-input relation is especially useful: it fixes the inputs associated with the film job, so later retry does not silently reinterpret a changing collection. Primary keys identify the durable records, foreign keys connect them, and uniqueness expresses rules such as one relevant membership or job identity.\n\nWe chose a relational store because this path depends on joins, consistency and transaction boundaries across related records. Hosted PostgreSQL also gives us managed backups. The code retains a local SQLite path, and the server suite runs across both dialects. For this explanation the important point is that privacy, lifecycle and recovery are stored relationships. The next section shows the tests that exercise those relationships through APIs and user actions.')
# Testing.
testrows=[['Static','Prettier / ESLint / tsc','4 checks','Static check matrix','YES','Types, style, imports'],['Client','Jest / Testing Library','1,674','Frontend + coverage','YES','Screens, state, retry'],['Server','node:test · SQLite','1,006','Server + coverage','YES','API, privacy, cycles'],['Database','node:test · PostgreSQL 17','989 pass','PostgreSQL suite','YES','Dialect and schema'],['Repository / IaC','node:test + Python','122 + 6','Root / IaC','YES','Policy and scan gate'],['Deployment','Shell / Python fixtures','11 scripts','Cloud-free fixtures','YES','Install and rollback'],['Browser / a11y','Playwright + Axe','41 / 6 Axe','Web / browser','main','PWA, layout, keyboard'],['Real-account','Playwright · Firefox','1 flow','Local slow check','NO','Owner, member, outsider'],['Performance','Node HTTP + FFmpeg','1,200 API / 3 films','Manual performance run','NO','Latency, film, privacy']]
add('s10',3,'TESTING','Each test layer catches a different integration failure.',table(['Type','Tool','Count','CI lane','Blocks?','Catches'],testrows,'testing')+'<div class="metric-row"><div><strong>89.64%</strong><span>Client statements · floor 70%</span></div><div><strong>92.33%</strong><span>Client lines</span></div><div><strong>85.67%</strong><span>Server lines · SQLite</span></div></div>',96,
 ['Static, client, server, database and deployment checks join the required Quality gate.','Browser and accessibility checks join for main; real-account and performance checks run separately.','The dated coverage is eighty-nine point six four percent client statements and eighty-five point six seven server lines.'],'A regression test is useful when it catches an actual interaction failure.',['B6'],'audit/E-testing.md §§1–3 · local 26 Oct at f6cd896',
 'This table separates the test types by the failure each can catch. Static checks enforce formatting, types and import boundaries. Jest and Testing Library exercise client logic and interaction state. The server suite drives API behaviour, privacy, media integrity and cycle rules using SQLite, and the full suite is exercised again on PostgreSQL seventeen. Repository and IaC tests cover architecture and policy rules. Cloud-free deployment fixtures inject failures around installation, transfer, health and recovery. Those lanes feed the aggregate Quality check.\n\nBrowser tests cover things that a unit test cannot demonstrate: responsive layout, PWA behaviour, keyboard use and accessibility. The baseline has forty-one Playwright tests, including six Axe checks. Those join the gate for main. The real-account Firefox flow and performance checks are separate runs. Performance is a test type here: the local script makes twelve hundred requests and compiles three films, while the hosted load study appears in the demonstration section.\n\nThese counts are the twenty-six October test audit at the application baseline. Client statement coverage is eighty-nine point six four percent against a seventy-percent floor; client line coverage is ninety-two point three three; server line coverage is eighty-five point six seven. I treat the coverage number as a way to find unexercised branches. The next example shows why the behavioural assertion matters.')
add('s11',3,'TESTING','“Try again” must return to a usable viewfinder.',
 split(block('<div class="bug-steps"><div><em>GIVEN</em><p>Photo capture fails</p></div><div><em>WHEN</em><p>User taps “Try again”</p></div><div><em>THEN</em><p>Viewfinder returns;<br>a fresh capture succeeds</p></div></div><div class="regression"><span>Before fix <b>FAIL</b></span><i>→</i><span>At f6cd896 <b>PASS</b></span></div>','Behavioural regression view · CU-A photo retry · #581'),points(('Fault.','Retry called capture from a state where its access guard immediately returned.'),('Repair.','Return to the viewfinder so the user can make a fresh capture.'),('Check.','Audit replayed the old source: the new test failed before the fix and passed afterward.'))),84,
 ['A visible retry button did nothing after a failed capture.','The test asserts the viewfinder and a fresh capture, not the presence of a button.','Replaying the old source failed the test; the current source passed.'],'The pipeline retains these results alongside the source and deployment artifacts.',['B3','B6'],'audit/E-testing.md §§7–8 · PR #581 · replay 26 Oct',
 'A concrete bug makes the testing approach easier to assess. After a failed photo capture, the screen showed Try again. The retry path called capture while the screen was still in a state that made the access guard return immediately. The button existed, but the interaction went nowhere. The repair returned the user to the viewfinder for a fresh capture.\n\nThe regression test follows the user action: induce failure, select Try again, verify that the viewfinder returns, then capture again. The audit replayed the previous source against that new test. It failed before the repair and passed at f6cd896. That is the behaviour we want preserved through refactoring. Other characterisation tests pinned route contracts, media denials and screen behaviour before module extraction. The lesson is to assert the observable recovery path, especially after an error or context change. A coverage increase is useful when it exposes a branch like this. The delivery section now shows how the same source revision travels with its test output, security inventory and deployable images.')
# Source and artifact management.
artifactrows=[['Source','Issue branch → PR → protected dev','Git history / review'],['Test evidence','JUnit · Jest JSON · coverage · npm-audit.json','Quality run artifacts'],['Image inventory','Runtime + web CycloneDX SBOMs','Deploy security artifact'],['Security reports','Exact-image Trivy JSON · ZAP HTML/JSON','Deploy run artifacts'],['Identity / provenance','Manifest + bundle + signed attestation','Actions artifacts / attestations']]
add('s12',4,'DEVSECOPS','A commit carries tests, inventory and deployment evidence.',
 '<div class="artifact-layout">'+fig('artifact-flow','Artifact flow view · source → verified dev bundle')+table(['Artifact family','Content','Retained in'],artifactrows,'artifacts')+'</div>',72,
 ['Issue branches reach protected dev through a PR and green Quality.','Actions retain tests, coverage, scan reports, the bundle and its identity manifest.','The artifact is the built image pair, not a new build on the host.'],'The pipeline shows where each decision happens.',['B12'],'PIPELINE-ARTIFACTS.md · artifact-flow',
 'Source management starts with a focused issue branch and a pull request to protected dev. The required Quality result belongs to the exact commit. Once merged, that same source revision triggers dev deployment. The artifact flow matters because a passing test run and a deployed application must be connected by identity.\n\nQuality retains root JUnit, server results and coverage, frontend Jest JSON and coverage, and the production dependency audit report. Deployment retains the runtime and web image inventories, the exact-image Trivy reports, the security manifest and the deployable tarball. Signed provenance binds the retained bundle and manifest to the workflow. After deployment, the ZAP reports describe the running hosted target. The host receives the built image pair in the verified bundle. It does not independently rebuild the application from a moving branch. These artifact families let us move from a source question to a test, package, scan or running-page result without treating those as interchangeable evidence.')
add('s13',4,'DEVSECOPS','Pipeline decisions separate merge gates from host activation.',split(fig('pipeline','Activity view · PR checks → Deploy dev → hosted DAST'),points(('Merge gate.','Aggregate Quality includes production dependency audit and parallel test lanes.'),('Deploy gate.','Same-commit Quality, bundle verification and exact-image Trivy precede host upload.'),('Report.','CodeQL, independent security jobs and post-deploy ZAP publish findings for triage.'),('Recovery.','Candidate health decides activation or restoration.'))),96,
 ['Read the decision points: scope, Quality, image security and candidate health.','Only aggregate Quality is branch-required; deployment has its own enforcing steps.','ZAP scans hosted dev after successful activation and reports its findings.'],'Here are the security procedures inside those lanes.',['B5','B12'],'PIPELINE-ARTIFACTS.md · pipeline · Deploy dev 40344230832',
 'There are several decisions inside this activity view. First, change classification decides whether the commit needs application checks or is documentation-only. A code change fans out across parallel static, client, server, PostgreSQL, root and deployment-fixture lanes. The aggregate fails on a failed or unexpectedly skipped required lane. Production dependency audit is part of that aggregate.\n\nSecond, deployment waits for a successful dev Quality run for the same commit. It builds and verifies the bundle, inventories the exact runtime and web images and scans those images. High or Critical findings at that exact-bundle gate stop host upload. This is a deployment gate even though the independent scan workflows are not branch-required checks.\n\nThird, the host installs a candidate and checks it before activation. Failure takes the restoration path. Once the host is serving, the passive ZAP baseline spiders hosted dev and publishes its report. SAST and the other security reports remain visible as their own lanes. The distinction is operational: branch protection requires the aggregate Quality context; a deployment step can independently stop the upload; a reporting lane retains findings for triage. The words BLOCKS and REPORTS in the figure refer to those specific decisions.')
securityrows=[['SAST','CodeQL · JS/TS, Python, Actions','3 load-script alerts → “used in tests”','Reports / triage'],['DAST','ZAP baseline · hosted dev','0 High · 4 Medium CSP · 7 Low · 6 Info','Post-deploy report'],['SCA','npm audit + Dependabot','Production audit HIGH+ joins Quality','Blocks merge'],['Secrets','Gitleaks + push protection','Full history scan + push-time secret checks','Scan + prevention'],['IaC','Trivy config · Terraform / Docker','Exact exceptions and expiry checks','Scan workflow gate'],['Images','Trivy · exact bundled runtime + web','0 High / Critical on both images','Blocks host upload']]
add('s14',4,'DEVSECOPS','Security checks cover code, packages, secrets and running pages.',table(['Procedure','Tool / scope','Result or policy','Decision'],securityrows,'security')+'<div class="takeaway">ZAP run 40344230832 · the four Medium findings concern Content Security Policy.</div>',102,
 ['CodeQL findings are triaged; three load-script alerts were closed as used in tests.','ZAP reports zero High, four Medium CSP, seven Low and six Informational findings.','Dependency audit, secrets controls, IaC checks and exact-image scans cover different failure modes.'],'The manifest ties the image results to the bytes we deployed.',['B12'],'PIPELINE-ARTIFACTS.md · pipeline-run-40344230832/zap · CodeQL triage 26 Oct',
 'SAST is CodeQL across JavaScript and TypeScript, Python and Actions. Tonight the three load-script alerts were triaged as used in tests. That is a written disposition attached to those alerts. The DAST lane now runs a ZAP baseline against hosted dev. The saved report for this deployment has zero High, four Medium, seven Low and six Informational findings. The Medium findings concern Content Security Policy. The HTML report gives the alert, affected URL, evidence and remediation text.\n\nSCA combines the production npm audit gate with Dependabot updates. High-severity production advisories fail Quality. Secret handling has both a full-history Gitleaks scan and repository push protection. The Gitleaks output is redacted SARIF; exceptions are narrow and match the intended historical values. IaC uses Trivy config on Terraform and Docker configuration, with exact findings and expiry dates checked by the gate.\n\nFinally, deployment scans the exact runtime and web images extracted from its verified bundle. Those scans enforce the High/Critical threshold before uploading to the host. Each tool examines a different surface. In the walkthrough I will open the retained outputs rather than treating a green workflow badge as the complete security explanation.')
excerpt={k:manifest[k] for k in ['commit','run_id','quality_run_id','security_gate']}
excerpt['runtime_image_id']=manifest['images']['runtime']['image_id']
excerpt['bundle_sha256']=manifest['sha256']['rewind-release.tar']
# Exact keys from real JSON, using a small excerpt rather than renamed properties.
manifesttext='\n'.join(['{','  "commit": "'+manifest['commit']+'",','  "run_id": "'+manifest['run_id']+'",','  "quality_run_id": "'+manifest['quality_run_id']+'",','  "security_gate": "pass",','  "sha256": {','    "rewind-release.tar":','    "'+manifest['sha256']['rewind-release.tar']+'"','  }','}'])
add('s15',4,'DEVSECOPS','The manifest binds deployed images to their scans.',split(block('<pre>'+esc(manifesttext)+'</pre><div class="image-counts"><b>Runtime</b> 0 H / 0 C · 1 M · 2 Unknown<br><b>Web</b> 0 H / 0 C · 0 M</div>','Real excerpt · release-manifest.json · run 40344230832'),points(('Inventory.','CycloneDX SBOM for each bundled image.'),('Identity.','Commit, Quality run, image IDs, archive digests and report hashes.'),('Provenance.','GitHub-signed attestations bind the bundle and manifest to the workflow.'),('Verify.','Use gh attestation verify on the downloaded bundle.'))),90,
 ['These fields are copied from the real deployment manifest.','Both bundled images have zero High and Critical findings.','The signed attestation and SHA-256 connect workflow identity to the retained bytes.'],'Next, follow those verified bytes to the hosted application.',['B12'],'pipeline-run-40344230832/security/release-manifest.json · manifest timestamp 26 Oct 14:59 UTC',
 'This excerpt is from the actual release manifest, with the original field names and values. It identifies commit aea7478, deployment run 40344230832 and Quality run 40344231052. The security gate passed. The bundle hash identifies the retained tarball. The full file also records each image configuration ID, image-archive and OCI manifest digests, severity counts, and hashes for the two SBOMs and two Trivy reports.\n\nBoth bundled images have zero High and Critical findings. The runtime report also has one Medium and two Unknown entries; the web image has none at those severities. The CycloneDX inventories list what is present in each exact image. The Trivy reports describe vulnerabilities against that inventory. The manifest links those files by hash. GitHub-signed build provenance then binds the bundle and security manifest to the workflow execution.\n\nThe verification command is gh attestation verify, naming our repository and the downloaded rewind-release.tar. A signature answers the build-origin and integrity question. The test and scan reports answer their own questions about behaviour and findings. Keeping those files together makes the deployment traceable without rebuilding an approximation later.')
add('s16',4,'DEVSECOPS','Hosted dev activates after candidate health succeeds.',split(fig('deploy-dev','Deployment view · GitHub Actions → hosted dev'),points(('Access.','GitHub OIDC exchanges workflow identity for temporary deploy credentials.'),('Host.','Nginx fronts the Node application; PostgreSQL and S3 retain shared data.'),('Activate.','Install the candidate, check health and switch current; failure restores the prior current.'),('Public check.','The run finishes with the hosted /api/health check.'))),72,
 ['OIDC gives the workflow temporary deploy credentials.','The host checks the candidate before switching current.','This run passed its public health check after installation.'],'The technical findings show why those package and runtime checks matter.',['B5','B12'],'Deploy dev 40344230832 · deploy-dev · release-host.sh',
 'The deployment view puts the logical design onto hosted dev. GitHub Actions obtains temporary deploy credentials through OIDC. It ships the verified bundle to the Lightsail host, where nginx fronts the Node process. The application uses PostgreSQL, private S3 storage, Cognito and web push. CloudFront is the public edge.\n\nActivation is a host decision. The installer prepares a candidate, verifies its health, then switches current. If the candidate is unhealthy, the installer restores the previous current. The deployment run then checks the public health endpoint. In our selected run, install completed at fifteen oh two forty-one UTC and the public check passed. The topology explains the runtime boundary, while the workflow and host installer explain who makes each decision. The following findings are examples of defects that escaped a narrower source-only view.')
findingsrows=[['New advisory in a locked dependency tree','3 High zod findings blocked Quality','Override update + clean audit'],['Alpine removed a pinned FFmpeg package','Image build failed before scan','Update to available 8.1.3-r0 pin'],['Schema registry moved during refactoring','Bundle verifier read the old location','Read the declared schema version'],['Service worker retained SSE forwarding','Group switching exhausted streams','Browser-owned SSE + cancellation checks'],['Retry UI preserved the failed state','“Try again” returned without capture','Behavioural test + viewfinder reset']]
add('s17',4,'DEVSECOPS','Packaging and runtime boundaries exposed useful defects.',table(['Finding','Consequence','Repair / learning'],findingsrows,'findings')+'<div class="takeaway">Test the adapter, the built image and the whole interaction.</div>',60,
 ['A locked dependency tree can still meet a new advisory, and a pinned package can disappear.','Refactoring must include packaging consumers; realtime must be checked through the service worker.','Whole-interaction tests caught the failed retry path.'],'Now follow one deployment run from Quality through artifacts and hosted health.',['B6','B12'],'records/FINDINGS.md · #591 · #583 · #568 · #581',
 'Five findings explain the checks we chose. A new zod advisory turned the production audit red even with a lockfile. The scoped dependency update restored a clean audit. Separately, Alpine removed the pinned FFmpeg package version, so the image failed before vulnerability scanning; the package pin had to move to the available version.\n\nA schema refactor moved the registry while deployment packaging still read the old location. Updating the packaging consumer restored bundle verification. In the PWA, service-worker forwarding prevented SSE cancellation from reaching upstream; repeated group changes then exhausted stream limits. Keeping SSE browser-owned repaired that lifetime. Finally, the failed-capture retry needed a behavioural test of the recovery path. The common lesson is to exercise the real boundary: the package repository, the built image, the service worker, or the full interaction. We can now see how those concerns appear in one retained deployment run.')
# CLI/live walkthrough with a slot for a recorded backup.
walk=table(['Stop','Show','Decision / output'],[['1','PR / Quality 40344231052','Scope classifier → parallel checks → aggregate'],['2','Required branch context','Format, lint, typecheck, and test'],['3','Security reports','CodeQL triage · audit · gitleaks · IaC'],['4','Deploy 40344230832','Same-commit gate → bundle → Trivy → attestation'],['5','Manifest, SBOM and ZAP','Exact images · signed origin · running-page findings'],['6','Hosted dev /api/health','Installed version and PostgreSQL readiness']],'walk')
add('s18',4,'DEMO','One run connects green Quality to hosted dev.',
 '<div class="demo-pipeline">'+block(walk,'CI/CD walkthrough · 26 Oct · aea7478')+'<div class="run-clock"><div><b>02:03</b> wait for Quality</div><div><b>00:53</b> build bundle</div><div><b>00:16</b> exact-image scan</div><div><b>01:16</b> host install</div><div><b>01:44</b> ZAP scan</div></div></div><div class="demo-actions"><button data-action="pipeline">P · pipeline recording</button><button data-action="commands">C · command cards</button><span>Run 40344230832 · successful · hosted dev</span></div><div class="pipeline-overlay" hidden><div class="clip" data-clip="clips/ci-cd-40344230832.mp4"><video preload="none" playsinline></video><div class="ph"><span class="tri"></span><strong>CI/CD · run 40344230832</strong><small>clips/ci-cd-40344230832.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><button data-action="pipeline">Close recording</button></div>',228,
 ['Open the same-commit Quality result, then the deployment steps.','Show the bundle inventory, manifest, signed provenance and ZAP report.','Finish on hosted dev health, then move into the user journey.'],'The same hosted system is the setting for the feature demonstration.',['B5','B12'],'gh run view · 40344231052 / 40344230832 · 26 Oct 2026',
 'I will now walk through the retained run. First, here is Quality run 40344231052. The classifier sends a code change through the parallel lanes and the aggregate collects their results. The branch-required context is named Format, lint, typecheck, and test. This is where the production audit participates in the merge decision.\n\n[00:00–00:45: show the Quality job graph and aggregate summary using the command cards.]\n\nNext, look at the separate security outputs. CodeQL has its language analyses and written alert dispositions. Gitleaks has its full-history report. IaC has its exact-finding policy. These outputs remain separate from the aggregate requirement. The old failed audit example is useful because it shows a required lane actually stopping integration when a new advisory arrived.\n\n[00:45–01:20: show saved scan inventory and the CodeQL triage record; open no repository page through a browser.]\n\nDeployment run 40344230832 names the same source commit. The wait-for-Quality step took two minutes and three seconds. Building the verified bundle took fifty-three seconds. Scanning the exact image archives and writing the manifest took sixteen seconds. The run retained the SBOMs, Trivy JSON and manifest, then attested the release bundle and security manifest. Those steps all precede the upload.\n\n[01:20–02:10: show the Deploy dev step table, then open the saved manifest and one SBOM. Point to the run ID, image identity and bundle hash.]\n\nThe host installation took one minute and sixteen seconds. The installer checked the candidate and the run passed its public health check. The subsequent ZAP scan took one minute and forty-four seconds and retained the report we saw: zero High, four Medium CSP, seven Low and six Informational findings. The sequence is important: exact-image security before upload, candidate health before activation, running-page DAST after deployment.\n\n[02:10–03:10: open the saved ZAP report. Follow one CSP alert to its evidence and recommendation. Show the attestation verification command and its retained subject identity.]\n\nFinally, hosted dev health reports the installed version and PostgreSQL readiness. This closes the trace from a specific source revision to the system we are about to use. A failing candidate follows the installer’s restoration path; we can inspect that source path or the deployment fixtures in questions.\n\n[03:10–03:48: show the hosted health response and return to the deck. Leave the manifest and ZAP artifacts ready for questions.]')
# Feature map, then 12 separately playable inserts.
add('s19',5,'DEMO','Follow one group from installation to a private film.',
 block('<div class="journey-map">'+''.join(f'<div><em>{a}</em><h2>{b}</h2><p>{c}</p></div>' for a,b,c in [('01–04','Enter','Install · sign in · create · invite'),('05–08','Contribute','Photo · video · chat · reminder'),('09–12','Reveal','Close · watch · save · deny outsider')])+'</div><div class="rule">Hosted dev · owner, invited member and outsider · one feature per clip</div>','Demonstration map · private-group journey'),18,
 ['We will follow an owner and invited member, then check the outsider boundary.'],'Start with installing the Home Screen app.',['B1','B3'],'audit/F1-system-demo.md §4 · videos/clips/',
 'The system demonstration follows one group. First enter through installation, sign-in and invitation. Then contribute photos and video, chat and opt into reminders. Finally follow automatic closure into the film and Archive, and check the outsider boundary. Each feature has its own clip so we can pause at an interruption.')
features=[
('F1','Installation keeps the app one tap away.','01-install-to-home-screen.mp4',45,'UC14 · Home Screen PWA',[('Do.','Safari → Share → Add to Home Screen → open.'),('Observe.','The installed app opens in its own Home Screen window.'),('Why.','This is the iPhone delivery surface.')], 'We start in Safari and add Rewind to the Home Screen. The installed app then opens as its own window. This is the iPhone delivery surface used for the journey. Watch the transition from the browser to the standalone app. Once it opens, the next step is identity.','Now sign in as Maya.','B5'),
('F2','Sign-in returns the member to the private-group journey.','02-sign-in.mp4',50,'UC01 · account sign-in',[('Do.','Sign in as Maya and open her group space.'),('Observe.','The authenticated account returns to Rewind.'),('Design.','Web identity supports Cognito code + PKCE with server-side exchange.')], 'Maya signs in and arrives in her private group space. The hosted development form gives us an authenticated account for this walkthrough. The web identity design also supports Cognito Managed Login using an authorization code with PKCE and a server-side exchange. The next decisions are about which group this account owns or belongs to.','Create the group and its shared prompt.','B5'),
('F3','A shared prompt gives the group a common starting point.','03-create-group.mp4',45,'UC02 / UC09 · create group',[('Do.','Name the group, set the prompt and choose its size.'),('Observe.','Home shows the new group; settings retain prompt and time zone.'),('Rule.','The owner manages group settings.')], 'The owner creates a group and chooses a shared prompt. The prompt gives contributions a common theme without prescribing what each person must record. The group size is bounded, and its settings retain the prompt and time zone. Point to the new group name and the prompt on Home, then to the owner settings. We now need another member.','Invite a friend with a single-use code.','B1'),
('F4','One accepted invitation creates one private membership.','04-invite-and-join.mp4',60,'UC03 · invite and join',[('Do.','Create and share the code; the friend accepts.'),('Observe.','Both accounts see the same group and member list.'),('Rule.','Code works once and expires in 24 hours.')], 'The owner creates an invitation and shares the code. It works once and expires after twenty-four hours. The friend signs in and accepts it. Watch the member list change and the shared group appear for both accounts. Acceptance is a server decision: a valid code and authenticated account produce a durable membership. Reusing the code later will not add another member. Keep that rule in mind for the final outsider check.','The first contribution is a photo.','B3'),
('F5','A submitted photo becomes a sealed moment.','05-photo-with-a-look.mp4',50,'UC05 · photo contribution',[('Do.','Take a photo, choose a look, review and submit.'),('Observe.','Your moments records a sealed entry.'),('Rule.','One photo uses one moment and three film seconds.')], 'Take a photo and choose a look before submitting it. The user can review the contribution, but after acceptance it becomes sealed. Your moments retains the entry and allowance information without opening everyone’s submitted content early. A photo counts as one moment and becomes a three-second segment in the film. Watch the state change from capture to a retained sealed entry.','Video shares the same weekly allowance.','B3'),
('F6','Video and photos share one enforced weekly allowance.','06-video-and-allowance.mp4',70,'UC04 / UC06 · video and allowance',[('Do.','Record with sound, trim and submit.'),('Observe.','The ledger updates moments and total seconds.'),('Rule.','5 moments / 30 seconds weekly; each video ≤15 seconds.')], 'Record a video with sound, review the trim and submit it. A video can use up to fifteen seconds, and the total weekly allowance is shared with photos: five moments and thirty seconds per member. The visible ledger matters because the user needs to know what remains before trying another capture. The server checks the accepted contribution and media rather than trusting only the client display. Pause at the updated counts. The contribution is now part of the same sealed collection as the photo.','The group can talk while the moments stay sealed.','B3'),
('F7','Stored messages and live updates keep the group connected.','07-group-chat.mp4',40,'UC11 · group chat',[('Do.','Send a message, reply and react from the other account.'),('Observe.','The second view updates without a refresh.'),('Design.','Stored messages plus SSE delivery and reconnect.')], 'One member sends a message and the other sees it without refreshing. Replies and reactions remain in the shared conversation. The design combines stored messages with live SSE delivery and reconnect, so the live notification is not the only record of the message. This is where the Observer design in backup B8 becomes visible to a user.','Next, opt into the weekly reminder.','B8'),
('F8','Reminder permission leads to an explicit weekly choice.','08-weekly-reminder.mp4',40,'UC10 · weekly web-push reminder',[('Do.','Open settings and enable the Sunday reminder.'),('Observe.','The Home Screen app requests notification permission.'),('Rule.','Sunday 19:00 in the group time zone; snooze seven days.')], 'Open reminders in the Home Screen app. The user chooses whether to receive the Sunday reminder and grants notification permission. The weekly schedule is Sunday at seven in the evening in the group’s time zone. A snooze lasts seven days. The useful interaction is the explicit permission and saved preference, with feedback tied to successful registration.','Now open the completed capsule and its premiere.','B5'),
('F9','The completed capsule is ready for its shared premiere.','09-cycle-ends-film-ready.mp4',50,'UC07 · automatic cycle closure',[('Observe.','A completed capsule exposes its premiere card.'),('Design.','The scheduler closes the cycle, queues work and opens its successor.'),('Rule.','The product cycle is 28 days.')], 'Here is the completed capsule from Maya and Jun. Its premiere card opens the shared film. Behind this result, the scheduler closes the ended cycle, queues durable compilation work and opens the successor. That is the CU-B path from the design section. Pause on the ready state, then continue to the film.','Open the group’s film.','B2'),
('F10','The reveal turns sealed contributions into one shared film.','10-watch-the-film.mp4',70,'UC08 / UC12 · premiere and playback',[('Do.','Open the premiere and watch; skip between moments.'),('Observe.','One film combines the group’s accepted inputs.'),('Output.','720 × 1280 · 30 fps · normalised audio.')], 'The film is now available to the group. Open the premiere and watch the contributions together. The player exposes moment segments and lets the viewer move between them. The output is a portrait film at seven-twenty by twelve-eighty, thirty frames per second, with normalised audio. Let a short section play with sound, then pause at the end screen. The film connects the sealed contribution habit to the shared payoff we described at the start.','Archive keeps the film and offers saving.','B2'),
('F11','Archive keeps the film available after its premiere.','11-archive-and-save.mp4',50,'UC12 / UC13 · Archive and save',[('Do.','Open Archive, select the film and save it.'),('Observe.','The MP4 download opens as a playable file.'),('Control.','Members can save the film and their own moments.')], 'After the premiere, the film remains in Archive. Open the retained film, choose Save film and open the downloaded MP4. The end screen also lets a member save their own moments. This completes the journey from capture to a durable output the member can keep. Pause on the playable downloaded result. The final check uses a different account that has no membership.','Check the outsider boundary.','B4'),
('F12','A spent invitation gives an outsider no group access.','12-outsider-denied.mp4',54,'Privacy boundary · outsider account',[('Do.','Reuse the spent invitation from an outsider account.'),('Observe.','The invitation is rejected and the private group stays absent.'),('Boundary.','Private group and media reads require their access checks.')], 'The outsider signs in with a different account and tries the invitation already used by our friend. The app rejects it as already used. The group does not appear in the outsider’s list. This is the negative branch of the invitation rule shown earlier. The server tests also exercise direct group, budget, chat and media access with missing or wrong membership. The user demonstration and those API checks address the same privacy boundary at different layers. We have now completed the group journey.','Finish with the hosted load results and the scaling mechanism.','B6')]
clip_secs=[45,45,60,60,55,65,55,50,40,80,55,50]
features=[(a,b,c,clip_secs[i],*rest) for i,(a,b,c,old,*rest) in enumerate(features)]
for id,title,file,secs,uc,pts,script,tr,back in features:
 clip='../videos/clips/'+file
 body=split('<div class="clip" data-clip="'+clip+'"><video preload="none" playsinline></video><img class="poster" src="assets/'+id+'-poster.jpg" alt="'+esc(uc)+'" onerror="this.style.display=\'none\'"><div class="ph"><span class="tri"></span><strong>'+esc(uc)+'</strong><small>'+esc(file)+'</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div>',points(*pts)+'<div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div>','clip-layout')
 add(id,5,'DEMO',title,body,secs,[p[1].replace('<br>',' ') for p in pts],tr,[back],'videos/clips/'+file+' · '+uc,script,kind='clip')
# Performance: clear measured table and named projection chart, with methodology.
perfrows=[['1','907','0.00%','0.21'],['10','537','0.00%','1.85'],['25','629','0.00%','4.63'],['50','859','0.00%','9.14'],['100','1,368','10.88%','17.31']]
# Own legible chart from documented model values.
proj='<svg viewBox="0 0 560 330" role="img" aria-label="Projected mean response time: one and two API hosts"><text x="45" y="25">Capacity projection · mean response (seconds)</text>'
for val in [0,10,20,30,40,50]:
 y=270-val*4.3;proj+=f'<path d="M55 {y}H535" stroke="#e0e3e4"/><text x="45" y="{y+7}" text-anchor="end">{val}</text>'
for lab,vals,color in [('1 host',[.779,7.847,20.584,46.096],'#ba501c'),('2 hosts',[.438,1.641,7.847,20.584],'#2c64a0')]:
 xy=' '.join(f'{85+i*140},{270-v*4.3}' for i,v in enumerate(vals))
 proj+=f'<polyline points="{xy}" fill="none" stroke="{color}" stroke-width="4"/>'
 for i,v in enumerate(vals):proj+=f'<circle cx="{85+i*140}" cy="{270-v*4.3}" r="5" fill="{color}"/>'
for i,n in enumerate([100,250,500,1000]):proj+=f'<text x="{85+i*140}" y="301" text-anchor="middle">{n}</text>'
proj+='<text x="130" y="328" fill="#ba501c">1 host</text><text x="260" y="328" fill="#2c64a0">2 hosts</text><text x="515" y="328" text-anchor="end">active users</text></svg>'
add('s20',5,'TESTING','Load results identify the next scaling change.',
 '<div class="perf-layout"><div>'+block(table(['VUs','p95 ms','Errors','req/s'],perfrows),'Measured hosted mixed workload · 26 Oct')+'<p class="perf-method"><b>Method:</b> Node HTTP · 1→100 VUs · 180 s steady per stage · 3–7 s think time.<br><b>Gate:</b> p95 &lt;2 s and errors &lt;1%.</p><div class="confirmation"><b>100-VU read-only confirmation</b><br>625 ms p95 · 18.42 req/s · 0 errors</div></div><div>'+block(proj,'Projected capacity · fitted operational scenario')+points(('Observed.','The mixed run’s 100-VU error interval overlaps deployment.'),('Scale.','Separate media work; remove synchronous database serialization; coordinate shared state.'),('Maintain.','The same pipeline checks the next change.'))+'</div></div>',192,
 ['The mixed run passed through fifty virtual users; the hundred-user stage had deployment-overlap errors.','A separate read-only hundred-user confirmation returned six hundred twenty-five milliseconds p95 with zero errors.','The capacity chart is a projection; the next changes target synchronous persistence and competing media work.'],'We can take questions using the backup map.',['B6','B11','B12'],'load-test/METHODOLOGY.md · RESULTS.md · 26 Oct hosted dev',
 'The quality-attribute demonstration uses the hosted API through CloudFront, Node and PostgreSQL. A plain Node HTTP runner steps through one, ten, twenty-five, fifty and one hundred virtual users. Each steady stage lasts three minutes. Users wait three to seven seconds between requests, and the mixed journey is mostly reads with five percent chat sends. The acceptance rule is p95 below two seconds and fewer than one percent errors.\n\nThe measured table shows zero errors through fifty users. At that level, p95 was eight hundred and fifty-nine milliseconds and throughput was nine point one four requests per second. At one hundred users, p95 remained below the latency target, but the error rate was ten point eight eight percent, so that stage failed its combined acceptance rule. The short upstream-error interval overlapped a deployment installation. The errors remain in the mixed-run result.\n\nA separate three-minute confirmation after deployment reused the same accounts and group with a read-only journey. It achieved six hundred and twenty-five milliseconds p95, eighteen point four two requests per second and zero errors at one hundred virtual users. That is a separate result with its own workload label.\n\nThe chart on the right is the capacity projection from the fitted operational scenario. It uses a serialized service demand of about fifty-one milliseconds per request, a fixed delay of about three hundred and forty-two milliseconds and five-second think time. The one-host model approaches nineteen point six requests per second. As user population rises, mean response time rises much faster than throughput. The two-host line divides arrival load between two service centers while holding the other assumptions fixed. Its values are model means; the measured table contains p95.\n\nThe mechanism behind the scaling work is visible in the code. The PostgreSQL bridge uses synchronous waiting and one client, which serializes parts of the request path. FFmpeg is a child process sharing the host CPU budget. Separating media work reserves API capacity, while asynchronous persistence and a bounded connection pool address request serialization. Multiple hosts also need coordinated media-capability state, local staging and job ownership; PostgreSQL and S3 remain shared.\n\nFor maintainability, return to the pipeline. A change to those internals should preserve the behavioural tests, database checks, verified image bundle, scan outputs and deployment health decision. That is how we can improve the mechanism while retaining the product behaviour demonstrated here. The backups contain the detailed model, coverage and diagrams for questions.')
# Twelve Q&A backup frames.
add('B1',2,'SAD','Analysis separates interaction, coordination and state.',split(fig('bce-cycle','Analysis class view · CU-B · boundary / control / entity'),points(('Boundary.','Receives the member’s view of cycle and film status.'),('Control.','Coordinates closure, compilation and reveal.'),('Entity.','Retains membership, cycle, job and film-input state.'))),0,['These are analysis responsibilities, then refined by the mapping on main frame six.'],'Return to the main analysis-to-design mapping.',['B2'],'audit/B1-analysis.md · bce-cycle','The analysis model separates the interaction boundary, use-case coordination and durable business state; main frame six maps those responsibilities to code.',kind='back')
add('B2',2,'SAD','Durable state survives interrupted compilation.',split(fig('state-cycle','State view · CU-B · cycle lifecycle'),points(('Lifecycle.','Collecting leads into processing and the released film states.'),('Retry.','Durable jobs preserve unfinished work across process stops.'),('Fence.','An old generation cannot finalise after ownership changes.'))),0,['The stored state and current claim determine what can happen next.'],'Return to the CU-B sequence.',['B4'],'audit/B1-analysis.md · state-cycle','Stored lifecycle state and durable jobs make work recoverable; a current lease and generation determine who may finalise.',kind='back')
add('B3',2,'SAD','Capture acceptance checks identity, allowance and media.',split(fig('seq-capture','Sequence view · CU-A · contribute a photo'),points(('Reserve.','Check the member and allowance before acceptance.'),('Upload.','Validate media bytes and processing metadata.'),('Accept.','Retain the sealed contribution with its budget effect.'))),0,['Acceptance crosses the server boundary and updates durable allowance state.'],'Return to the feature clip.',['B6'],'audit/B1-analysis.md · seq-capture','The capture sequence follows reservation, media validation and acceptance, keeping membership and allowance decisions on the server.',kind='back')
add('B4',2,'SAD','Relational keys make the private film traceable.',split(fig('er-core','ER view · CU-B · PostgreSQL schema detail'),points(('Choice.','Transactions, relational integrity and managed backup support the group workflow.'),('Compared.','SQLite remains useful locally; a document store would still need cross-record consistency.'),('Trace.','Frozen compilation inputs link the finished film to its source set.'))),0,['PostgreSQL supports the transactional relationships this workflow needs.'],'Return to the schema or Archive frame.',['B9'],'audit/B2-design.md · ADR-0003 · er-core','The relational choice follows transaction and consistency needs across membership, cycles, contributions and the frozen film input set.',kind='back')
add('B5',4,'DEVSECOPS','The deployment view names each runtime boundary.',split(fig('deploy-dev','Deployment view · hosted dev · application and managed services'),points(('Edge.','CloudFront and nginx route the public web/API entry.'),('Runtime.','Node and media processing run on the host.'),('Services.','PostgreSQL, private S3, Cognito and web push keep explicit interfaces.'))),0,['The diagram places the logical components on their hosted runtime and service boundaries.'],'Return to the CI/CD run.',['B12'],'audit/B2-design.md · deploy-dev','CloudFront and nginx form the entry, Node runs the application, and PostgreSQL, S3 and Cognito provide the durable data and identity services.',kind='back')
coverage=[['Client statements','89.64%','89.66%','70% statement floor'],['Client branches','85.68%','85.66%','Reported'],['Client functions','89.55%','89.61%','Reported'],['Client lines','92.33%','92.33%','Reported'],['Server lines','85.67%','85.50%','Reported'],['Server branches','85.62%','85.66%','Reported'],['Server functions','85.05%','86.41%','Reported']]
add('B6',3,'TESTING','Coverage and enforcement answer different questions.',table(['Coverage','Local 26 Oct','CI 20 Oct','Policy'],coverage)+'<div class="backup-bottom">'+points(('Cases.','1,674 frontend; 1,006 server; 122 root; 41 browser including 6 Axe.'),('Privacy.','Route contracts and outsider tests exercise group, budget, chat and private media denials.'),('Performance.','Local: 1,200 requests; 3 × 25-clip films in 4.9–8.1 seconds.'))+'</div>',0,['Client statements have an enforced floor; server coverage is retained as a report.'],'Return to the testing table.',['B11'],'audit/E-testing.md §§1–3,6 · f6cd896','The statement floor is a regression safety net. Coverage reports identify branches to investigate, while behavioural tests assert the outcomes that matter.',kind='back')
add('B7',2,'SDP','Storage changes behind Strategy and Adapter roles.',split(fig('pattern-storage','Pattern class view · storage · Strategy + Adapter'),points(('Problem.','Local disk and hosted S3 use different protocols.'),('Candidates.','Conditionals at call sites; subclassing; interface with injected implementations.'),('Chosen.','MediaStore strategy with concrete storage adapters.'))),0,['The interface isolates the storage choice and each adapter handles its protocol.'],'Return to the architecture decision.',['B9'],'audit/B2-design.md · pattern-storage','We chose a storage interface with concrete adapters so callers use one contract while disk and S3 retain their own protocol handling.',kind='back')
add('B8',2,'SDP','Observer distributes chat updates alongside stored history.',split(fig('pattern-observer','Pattern class view · chat · Observer / RealtimeHub'),points(('Problem.','Several active screens need the same new message.'),('Candidates.','Polling, direct callbacks, publish/subscribe.'),('Chosen.','RealtimeHub observers plus stored messages and reconnect.'))),0,['RealtimeHub distributes live updates; stored messages support replay.'],'Return to the chat clip.',['B5'],'audit/B2-design.md · pattern-observer','RealtimeHub acts as the live update subject and subscribers receive events, while stored messages provide the durable history and reconnect path.',kind='back')
add('B9',2,'SDP','The persistence adapter preserves a common data-access contract.',split(fig('pattern-persistence','Pattern class view · persistence · PostgresDatabase Adapter'),points(('Problem.','Hosted PostgreSQL differs from the local database API.'),('Candidates.','Rewrite callers; spread dialect branches; central adapter.'),('Chosen.','PostgresDatabase centralises translation and transaction behaviour.'))),0,['The adapter centralises dialect work; its synchronous bridge also informs the scaling discussion.'],'Return to the capacity model.',['B4','B11'],'audit/B2-design.md · pattern-persistence','PostgresDatabase adapts the common call contract to PostgreSQL; centralising that translation also makes the synchronous bridge a clear target for performance work.',kind='back')
# PM backup uses original figures as selectable views and prints a compact full record.
pm=chart_img('records/charts/burndown-sprint-3.png','Burndown record · Sprint 3 · scope and remaining issues')
add('B10',1,'PM','Agile records retain scope changes and equal effort.',split(pm,points(('Effort.','Five members, 20% each; 10 planned person-days per member.'),('Burndown.','Sprint 3: scope 18→45; open 3→5. Sprint 2: scope 9→135; open 3→9.'),('Velocity.','Issues closed: 44 / 100 / 145 / 30. PRs merged: 11 / 36 / 132 / 34.'),('Delivery register.','26 Oct: #230, #362, #504, #515, #527, #587, #588.')))+'<div class="chart-switches">'+''.join(f'<button data-chart="assets/burndown-sprint-{i}.png">Sprint {i}</button>' for i in range(4))+'<button data-chart="assets/velocity.png">Velocity</button></div>',0,['Burndown replays milestone and close events; velocity counts closures in each sprint window.'],'Return to the PM summary.',['B6'],'records/AGILE.md · TEAM.md · data/velocity.csv · burndown CSVs','The burndowns retain scope change and reopen events. Equal effort is the agreed twenty-percent split, and the dated register retains all seven outstanding delivery items.',kind='back')
add('B11',5,'TESTING','The capacity curve follows the closed-user workload.',split(chart_img('load-test/charts/measured-vs-projected.png','Performance view · measured and projected mean response'),points(('Fit.','S = 51.039 ms/request; L = 341.8 ms; Z = 5 s.'),('Equations.','U = λS; R = L + S/(1−U); λ = N/(Z+R).'),('Projected.','1 host ≈19.6 req/s ceiling; 2 ideal balanced hosts ≈39.2 req/s.'),('Next step.','Asynchronous persistence, media-worker separation and coordinated shared state.'))),0,['The model solves throughput and response time together as users wait between actions.'],'Return to the measured performance table.',['B9'],'load-test/RESULTS.md · results/capacity-model.json','The closed-user model includes think time, so slower responses reduce offered throughput. Its fitted scenario includes the initial run’s deployment-overlap interval.',kind='back')
add('B12',4,'DEVSECOPS','Retained artifacts make the deployment independently inspectable.',table(['File / output','Question it answers'],[['quality-test-results-root · server/frontend coverage','Which behaviours and coverage were exercised?'],['npm-audit.json · gitleaks.sarif · iac-full.json','Which dependency, secret and configuration findings were reported?'],['sbom-runtime.cdx.json · sbom-web.cdx.json','Which components are inside the image pair?'],['trivy-runtime.json · trivy-web.json','Which findings belong to those exact images?'],['release-manifest.json · rewind-release.tar','Which commit, bytes and report hashes travelled together?'],['Signed provenance · gh attestation verify','Which workflow produced the retained subjects?'],['ZAP report_html.html · report_json.json','Which running-page findings were observed?']])+'<pre class="command">gh attestation verify --repo Collaboration95/rewind-app rewind-release.tar</pre>',0,['The manifest links identity and report hashes; provenance binds the retained subjects to the build.'],'Return to the CI/CD walkthrough.',['B5'],'PIPELINE-ARTIFACTS.md · pipeline-run-40344230832/','Use the manifest for commit and image identity, SBOMs for inventory, scan JSON for findings, provenance for build origin and ZAP for the running hosted page.',kind='back')
# Copy chart sources (owned assets only).
for src in (P/'records/charts').glob('*.png'):shutil.copy2(src,D/'assets'/src.name)
for src in (P/'load-test/charts').glob('*.png'):shutil.copy2(src,D/'assets'/src.name)
# Generate video posters from final clips, without rewriting the clips.
for s in slides:
 if s['kind']=='clip':
  rel=re.search(r'data-clip="([^"]+)"',s['body']).group(1);v=(D/rel).resolve();out=D/'assets'/f"{s['id']}-poster.jpg"
  if v.exists() and (not out.exists() or out.stat().st_mtime<v.stat().st_mtime):
   subprocess.run(['ffmpeg','-hide_banner','-loglevel','error','-ss','1','-i',str(v),'-frames:v','1','-vf','scale=960:-1','-y',str(out)],check=True)
# Supplementary SVGs are embedded as alternate figure views within existing frames.
used=set(re.findall(r'data-figure="([^"]+)"',''.join(s['body'] for s in slides)))
extra=[x for x in sorted((D/'uml').glob('*.svg')) if x.stem not in used]
for f in extra:
 target='s4' if f.stem.startswith('uc-model-') else 's8' if f.stem.startswith('seq-cycle-') else 'B3'
 for s in slides:
  if s['id']!=target:continue
  # Embed the image in a hidden alternate panel; a view switch displays it at full figure size.
  title=f.stem.replace('-',' ')
  panel='<div class="alternate-view" data-view="'+f.stem+'" hidden><img src="uml/'+f.name+'" alt="UML view · '+title+'"></div>'
  s['body']+=panel
  if 'data-default-view' not in s['body']:
   s['body']+='<div class="figure-switches"><button data-default-view="true">Overview</button></div>'
  s['body']=s['body'].replace('</button></div>', '</button><button data-alt-view="'+f.stem+'">'+title+'</button></div>',1) if False else s['body']
  pos=s['body'].index('<div class="figure-switches">')+len('<div class="figure-switches">')
  s['body']=s['body'][:pos]+'<button data-alt-view="'+f.stem+'">'+title+'</button>'+s['body'][pos:]
  break
# Reference theme overrides preserve the framework's mechanics and primitive CSS.
css='''
:root{--cream:#F5F2E9;--navy:#14202B;--ink:#14202B;--muted:#50606a;--orange:#B4501A;--pm:#B4501A;--sad:#7255B7;--sdp:#2C64A0;--testing:#9a3d62;--devsecops:#247B72;--demo:#367348}
html,body{color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif}
#stage,.slide{background:var(--cream)}.slide{padding:43px 64px 0}.slide h1{font-size:37px;line-height:1.13;min-height:44px;letter-spacing:-.7px;margin:13px 0 17px;font-weight:750}.kicker{font:600 15px Menlo,monospace;letter-spacing:1.15px;color:var(--accent);text-transform:uppercase}
.body{margin-bottom:64px;justify-content:flex-start}.split{display:grid;grid-template-columns: 2.03fr 1fr;gap:28px;height:100%;align-items:stretch;min-height:0}.figure{background:#fff;border:1px solid #deded6;border-radius:9px;min-width:0;padding:16px;overflow:hidden;position:relative;margin:0;display:flex;flex-direction:column;justify-content:center}.figuretitle,figcaption{font:600 14px Menlo,monospace;letter-spacing:.1px;color:#53616a;margin:0 0 12px;flex-shrink:0}.diagram img{width:100%;height:0;flex:1;object-fit:contain;min-height:0}.fig-placeholder{position:absolute;inset:60px 22px 24px;display:flex;gap:20px;flex-direction:column;justify-content:center;align-items:center;text-align:center;border:2px dashed #d2d5d1;border-radius:6px;background:#fafaf7}.fig-placeholder span{font:15px Menlo,monospace;color:#776d8e}.fig-placeholder strong{font-size:28px;max-width:520px}.fig-placeholder code{font:18px Menlo,monospace;color:#66727a}.diagram.loaded .fig-placeholder{display:none}.explain{align-self:center;font-size:24px;line-height:1.3;color:var(--muted)}.explain p{margin:0 0 23px}.explain p:last-child{margin:0}.explain b{color:var(--ink)}.foot{left:64px;right:64px;padding:0;height:47px;background:transparent;border-top:1px solid #d7d7ce;color:#5e6b72;font:12px Menlo,monospace;gap:20px}.foot .source{max-width:1000px}.counter{flex:none;font:600 15px Menlo,monospace}.section-progress{position:absolute;top:0;left:0;width:100%;display:flex;height:6px;gap:3px}.section-progress span{flex:1;background:#deded4}.section-progress .done,.section-progress .current{background:var(--accent)}.section-progress .done{opacity:.5}#bar{top:auto;bottom:0;height:3px;background:var(--accent)!important}
.slide.cover{background:var(--navy);color:var(--cream);padding-top:52px}.cover .kicker{color:#eea16d}.cover h1{font-size:30px;color:#dbe2de;font-weight:450;margin:18px 0 0}.cover .body{justify-content:center}.cover-word{font-size:125px;font-weight:750;letter-spacing:-6px;line-height:1.1}.cover-word span{color:#e69b63;display:inline-block;margin-left:28px;font-size:115px}.cover-sub{font-size:31px;color:#d3dcd8;margin:23px 0}.cover-loop{display:flex;gap:29px;align-items:center;font:22px Menlo,monospace;color:#efe5cd;margin-top:26px}.cover-loop i{font-size:35px;color:#d08c5d;font-style:normal}.cover-meta{font:17px/1.7 Menlo,monospace;margin-top:52px;color:#a7b6b8}.cover .foot{border-color:#4c585e;color:#a7b6b8}.cover .section-progress span{background:#3c484b}
h2{font-size:29px;letter-spacing:-.4px;line-height:1.2;margin:11px 0}.product-loop,.journey-map{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.product-loop div,.journey-map div{padding:25px 8px}.product-loop em,.journey-map em,.bug-steps em{font:18px Menlo,monospace;color:var(--accent);font-style:normal}.product-loop p,.journey-map p{font-size:24px;line-height:1.4;color:var(--muted)}.rule{border-top:1px solid #e1e0d7;margin-top:20px;padding:24px 8px;font-size:23px;color:var(--orange)}
.data{width:100%;border-collapse:collapse;font-size:23px;line-height:1.2;table-layout:auto}.data th{text-align:left;font-size:16px;font-family:Menlo,monospace;color:#52616a;border-bottom:2px solid #9ba5a4;padding:10px 10px 12px}.data td{padding:13px 10px;border-bottom:1px solid #d7d9d2;vertical-align:top}.data tr:last-child td{border-bottom:0}.data td:first-child{font-weight:650}.data.testing{font-size:19px;table-layout:fixed}.data.testing th:nth-child(1){width:14%}.data.testing th:nth-child(2){width:20%}.data.testing th:nth-child(3){width:14%}.data.testing th:nth-child(4){width:22%}.data.testing th:nth-child(5){width:9%}.data.testing th:nth-child(6){width:21%}.data.testing th{font-size:14px}.data.testing td{padding:7px 7px;line-height:1.15}.data.testing td:nth-child(5){font:600 15px Menlo,monospace;color:#247b72}.metric-row{display:flex;gap:36px;margin:14px 8px 0}.metric-row div{flex:1}.metric-row strong{font-size:33px;color:#9a3d62}.metric-row span{display:block;font-size:19px;color:#5d686d;margin-top:4px}.pm-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:30px;min-height:0;flex:1}.pm-grid .data{font-size:20px}.pm-grid .data td{padding:10px}.pm-grid p{font-size:21px;line-height:1.26;margin:0 0 15px}.pm-grid .figure{margin-top:9px;padding:10px;height:161px}.pm-grid svg{width:100%;height:100%}.pm-grid svg text{font-size:22px;fill:#4a5c65;font-family:-apple-system,Arial}.status-strip{font-size:16px;line-height:1.4;margin-top:11px;padding:13px 0 0;border-top:1px solid #c7cdc6}.status-strip b{font:600 14px Menlo,monospace;color:#b4501a;margin-right:10px}.status-strip span{display:block;color:#68747a;font-size:14px;margin-top:5px}
.bug-steps{display:flex;flex-direction:column;gap:13px}.bug-steps>div{border-bottom:1px solid #ddd;padding:12px 7px}.bug-steps p{font-size:28px;margin:8px 0}.regression{display:flex;justify-content:space-around;align-items:center;font-size:22px;margin-top:20px}.regression b{display:block;font:600 31px Menlo,monospace;margin-top:12px}.regression span:first-child b{color:#aa443b}.regression span:last-child b{color:#247b72}.regression i{font-size:38px;font-style:normal}.artifact-layout{display:grid;grid-template-columns:1.15fr 1fr;gap:26px;height:100%}.data.artifacts{font-size:20px}.data.artifacts td{padding:11px 9px}.data.security{font-size:23px}.data.security td{padding:15px 10px}.data.security td:nth-child(3){max-width:370px}.takeaway{font-size:24px;color:#b4501a;margin-top:21px}.data.findings{font-size:22px}.data.findings td{padding:13px 10px}pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:normal;font:17px/1.65 Menlo,monospace;margin:0;color:#273f4c}.image-counts{font:20px/1.7 Menlo,monospace;margin-top:22px;border-top:1px solid #ddd;padding-top:20px}.data.walk{font-size:23px}.data.walk td{padding:16px 9px}.run-clock{display:flex;gap:20px;margin-top:22px}.run-clock div{flex:1;font-size:17px;color:#52616a}.run-clock b{display:block;font:600 26px Menlo,monospace;color:#247b72;margin-bottom:8px}.demo-actions{display:flex;gap:15px;align-items:center;margin-top:23px;font-size:17px;color:#576b72}button{border:1px solid #c5cac4;background:transparent;border-radius:5px;padding:8px 12px;color:#38545c;font:14px Menlo,monospace;cursor:pointer}button:hover{background:#e0e6df}.pipeline-overlay{position:absolute;inset:0;background:#f5f2e9;z-index:4;padding:8px;display:flex;gap:12px;flex-direction:column;align-items:center}.pipeline-overlay[hidden]{display:none}.pipeline-overlay .clip{width:850px;height:478px}.commands{position:absolute;inset:0;background:#f5f2e9;padding:18px;z-index:3}.commands pre{font-size:21px;line-height:1.8}.commands h2{font-size:26px}.commands p{font-size:23px}
.clip-layout{grid-template-columns:2.03fr 1fr}.clip-layout .clip{width:100%;height:100%;border-radius:9px;background:#14202b}.clip .poster{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#14202b}.clip .ph{font-size:26px;gap:21px;border-width:1px;border-color:#637076}.clip .ph small{font:16px Menlo,monospace;word-break:break-word}.clip.ready .poster{display:none}.clip .poster+.ph{background:rgba(20,32,43,.8)}.clip-hint{font:15px/1.6 Menlo,monospace;color:#738076;margin-top:27px}.clip video{z-index:2}.clip .pb,.clip .cb{z-index:3}.clip .cb{background:#e09c62}.clip .poster{opacity:.45}.clip-layout .clip.ready{background:#000}
.perf-layout{display:grid;grid-template-columns:1fr 1.15fr;gap:25px;height:100%}.perf-layout .figure{padding:15px;justify-content:flex-start}.perf-layout .data{font-size:24px}.perf-layout .data td{padding:12px}.perf-layout svg{height:270px;width:100%}.perf-layout svg text{font:20px -apple-system,Arial;fill:#53636a}.perf-layout .explain{font-size:19px}.perf-layout>div>p{font-size:20px;line-height:1.3}.perf-layout>div>p b{color:#14202b}.perf-layout>div>p{margin:14px 0}.perf-method{font-size:19px!important;color:#52616a;line-height:1.4!important}.confirmation{border-left:4px solid #247b72;padding-left:15px;font-size:20px;line-height:1.5;margin-top:13px}.chart img{width:100%;height:calc(100% - 30px);object-fit:contain}.backup-bottom{display:flex;gap:25px;margin-top:25px;font-size:21px}.backup-bottom p{flex:1;margin:0}.chart-switches{display:flex;gap:10px;margin-top:10px}.command{font-size:18px;border-top:1px solid #ccc;margin-top:22px;padding-top:18px}.figure-switches{position:absolute;bottom:-24px;left:0;display:flex;gap:8px}.figure-switches button{font-size:11px;padding:4px 7px}.alternate-view{position:absolute;inset:32px 16px 16px;background:#fff;z-index:2;display:flex;align-items:center;justify-content:center}.alternate-view[hidden]{display:none}.alternate-view img{width:100%;height:100%;object-fit:contain}.body:has(.alternate-view:not([hidden]))>.split>.figure{visibility:hidden}.body>.alternate-view{right:34%;border:1px solid #deded6;border-radius:9px;padding:14px}.figure-switches{z-index:4}#figure-zoom{position:fixed;inset:0;background:#f5f2e9;z-index:70;padding:55px 20px 20px;display:flex;flex-direction:column}.zoom-close{position:absolute;right:20px;top:12px;background:#fff}.zoom-scroll{overflow:auto;flex:1;background:#fff;border-radius:8px;border:1px solid #d3d8d2}.zoom-scroll img{display:block;width:auto;height:auto;min-width:1100px;margin:25px auto}.diagram{cursor:zoom-in}#notes{font-family:-apple-system,Arial;font-size:20px}#notes p{margin:6px 0}#ov .th{background:#f5f2e9}#ov .th .in .slide{padding-top:43px}.clip.print-poster .ph{background:transparent}.clip.print-poster .ph>*{visibility:hidden}.clip.print-poster .poster{opacity:1}
@media print{html,body{print-color-adjust:exact;-webkit-print-color-adjust:exact}.slide{padding:43px 64px 0}.section-progress{display:flex!important}.foot{background:transparent}.clip .poster{opacity:1!important;display:block!important;z-index:2}.clip .ph{z-index:1;background:#14202b}.clip .pb,.chart-switches,.demo-actions,.pipeline-overlay,.commands,.figure-switches,.alternate-view,#figure-zoom{display:none!important}.diagram .fig-placeholder{background:#fafaf7}.cover{background:#14202b!important}.cover .foot{background:transparent}.slide:last-child{break-after:auto}}
'''
# All counters are generated; no numbers are authored into footer text.
main=0; back=0; sections=['PM','SAD / SDP','TESTING','DEVSECOPS','DEMO']
htmlslides=[]
clock=0
for s in slides:
 if s['kind']=='main':main+=1; num=str(main)
 elif s['kind']=='clip':num=s['id']
 else:back+=1;num=s['id']
 s['label']=num
 s['clock']=clock
 if s['kind'] in ['main','clip']:clock+=s['secs']
 s['mainindex']=main
 accent={'PM':'pm','SAD':'sad','SDP':'sdp','TESTING':'testing','DEVSECOPS':'devsecops','DEMO':'demo'}[s['tag']]
 strip='<div class="section-progress" aria-label="Five section progress">'+''.join('<span class="'+('done' if j<s['sec'] else 'current' if j==s['sec'] else '')+'" title="'+sections[j-1]+'"></span>' for j in range(1,6))+'</div>'
 timing=(f"{s['secs']//60}:{s['secs']%60:02d}" if s['secs'] else 'Q&A')
 notes='<b>'+timing+' · Section '+str(s['sec'])+' · '+s['tag']+'</b>'+''.join('<p>Say: '+esc(x)+'</p>' for x in s['say'][:3])+'<p>Transition: '+esc(s['transition'])+'</p><p>If asked: '+ ' · '.join('→ '+x for x in s['refs'])+'</p>'
 footer='<div class="foot"><span class="source">'+esc(s['source'])+'</span><span class="counter"></span></div>'
 body=s['body']
 htmlslides.append(f'<section class="slide {s["extra"]}" id="{s["id"]}" data-kind="{s["kind"]}" data-num="{num}" data-main="{s["mainindex"]}" data-sec="{s["sec"]}" data-time="{s["secs"]}" style="--accent:var(--{accent})">{strip}<div class="kicker">{s["tag"]} · '+('SWE5006 / TEAM 14' if s['id']=='s1' else 'SECTION '+str(s['sec']))+'</div><h1>'+s['title']+'</h1><div class="body">'+body+'</div>'+footer+'<aside class="notes">'+notes+'</aside></section>')
# Framework fork: preserve scale, arrows, notes, overview, blackout, fullscreen, video, hash.
basejs=basejs.replace("var mainCount=slides.filter(function(s){return s.dataset.kind==='main'}).length;", "var mainCount=slides.filter(function(s){return s.dataset.kind==='main'}).length;\nslides.forEach(function(s,i){s.querySelector('.counter').textContent=s.dataset.kind==='main'?s.dataset.num+' / '+mainCount:s.dataset.kind==='clip'?s.dataset.num+' · feature / 12':s.dataset.num+' · backup';s.dataset.physical=i+1});")
basejs=basejs.replace("var isMain=slides[i].dataset.kind==='main';", "var isMain=slides[i].dataset.kind==='main'||slides[i].dataset.kind==='clip';")
basejs=basejs.replace("(100*(i+1)/mainCount)","(100*Number(slides[i].dataset.main)/mainCount)")
basejs=basejs.replace("slides.forEach(function(s,j){if(j===i)s.classList.add('active')});", "slides.forEach(function(s,j){s.classList.toggle('active',j===i)});")
basejs=basejs.replace("if(v.duration)c.querySelector('.cb').style.width", "if(v.duration&&c.querySelector('.cb'))c.querySelector('.cb').style.width")
# Named hash anchors work alongside numeric physical jumps.
basejs=basejs.replace("function fromHash(){var n=parseInt", "function fromHash(){var id=(location.hash||'').slice(1);var found=slides.findIndex(function(s){return s.id===id});if(found>=0)return found;var n=parseInt")
# Overview click handler is added: the original fork only had its visual grid.
basejs=basejs.replace("fit();go(fromHash(),true);", "ov.addEventListener('click',function(e){var t=e.target.closest('.th');if(t){toggleOv(false);go(Number(t.dataset.i))}});\nfit();go(fromHash(),true);\nwindow.deck={go:go,slides:slides,fit:fit};\n")
basejs=basejs.replace("else if(k==='p'||k==='P'){toggleClip()}", "else if(k==='p'||k==='P'){var po=slides[cur].querySelector('.pipeline-overlay');if(po&&po.hidden)po.hidden=false;initClip(clipOf(cur));toggleClip()}\nelse if(k==='c'||k==='C'){toggleCommands()}\nelse if(k==='z'||k==='Z'){toggleFigureZoom()}")
# Add command cards without external calls or GitHub browser access.
commands='''<h2>CI/CD demonstration · authenticated gh CLI</h2><pre>gh run view 40344231052 -R Collaboration95/rewind-app\ngh api repos/Collaboration95/rewind-app/branches/dev/protection\ngh run view 40344230832 -R Collaboration95/rewind-app\ngh api repos/Collaboration95/rewind-app/actions/runs/40344230832/artifacts\ngh attestation verify --repo Collaboration95/rewind-app rewind-release.tar</pre><p>Open saved files: release-manifest.json → SBOM → Trivy JSON → ZAP HTML.</p><p>Hosted dev: https://d2m6kz76y4kuvm.cloudfront.net/api/health</p><button data-action="commands">C · close command cards</button>'''
injection="\nfunction toggleFigureZoom(src){var old=document.getElementById('figure-zoom');if(old){old.remove();return}var im=src||slides[cur].querySelector('.alternate-view:not([hidden]) img,.diagram img');if(!im)return;var z=document.createElement('div');z.id='figure-zoom';z.innerHTML='<button class=zoom-close>Z / click · close figure</button><div class=zoom-scroll><img></div>';z.querySelector('img').src=im.src;z.querySelector('img').alt=im.alt;z.querySelector('button').onclick=function(){z.remove()};document.body.appendChild(z)}\ndocument.addEventListener('dblclick',function(e){if(e.target.matches('.diagram img,.alternate-view img'))toggleFigureZoom(e.target)});\nfunction toggleCommands(){var s=slides[cur];var c=s.querySelector('.commands');if(c){c.remove();return}c=document.createElement('div');c.className='commands';c.innerHTML=COMMANDS_JSON;s.querySelector('.body').appendChild(c)}\ndocument.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;if(b.dataset.defaultView){slides[cur].querySelectorAll('.alternate-view').forEach(function(x){x.hidden=true})}if(b.dataset.altView){slides[cur].querySelectorAll('.alternate-view').forEach(function(x){x.hidden=x.dataset.view!==b.dataset.altView})}if(b.dataset.action==='commands'){toggleCommands()}if(b.dataset.action==='pipeline'){var c=slides[cur].querySelector('.pipeline-overlay');c.hidden=!c.hidden;if(c.hidden)c.querySelector('video').pause();else initClip(c.querySelector('.clip'))}if(b.dataset.chart){var im=slides[cur].querySelector('.chart img');im.src=b.dataset.chart;im.alt=b.textContent+' agile chart';slides[cur].querySelector('.chart figcaption').textContent='Agile record · '+b.textContent}});\n"
basejs=basejs.replace("var cur=-1,buf='',hudT=0;", "var cur=-1,buf='',hudT=0;"+injection.replace('COMMANDS_JSON',json.dumps(commands)))
# Escape HTML in generated metadata only; preserve authored slide markup.
document='<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rewind · SWE5006 Team 14 · 27 October 2026</title><style>'+basecss+'\n'+css+'</style></head><body><div id="stage"><div id="bar"></div>'+''.join(htmlslides)+'</div><div id="notes"></div><div id="ov"></div><div id="black"></div><div id="hud"></div><script>'+basejs+'</script></body></html>'
(D/'deck.html').write_text(document)
(D/'slides.json').write_text(json.dumps([{k:v for k,v in s.items() if k!='body'} for s in slides],indent=2))
# Full spoken script and clock table.
lines=['# Rewind · full spoken script','','SWE5006 Team 14 · Gopal Guruprasath · 27 October 2026, 14:30 SGT.','','## Timing table','','| Section | Start | End | Budget |','|---|---:|---:|---:|','| 1 · Intro and project management | 00:00 | 03:30 | 3:30 |','| 2 · Analysis, design and patterns | 03:30 | 08:30 | 5:00 |','| 3 · Testing | 08:30 | 11:30 | 3:00 |','| 4 · CI/CD demonstration | 11:30 | 23:30 | 12:00 |','| 5 · System demo and quality attributes | 23:30 | 38:00 | 14:30 |','| **Talk total** | **00:00** | **38:00** | **38:00** |','','Five minutes of Q&A follow. The remaining two minutes in the forty-minute slot absorb interruptions. Feature timings include playback, pauses and narration; the CI/CD frame includes the timed inspection actions.','','## Presentation controls','','Arrow keys / A / D: change frame. N: notes. O: overview. F: fullscreen. B: blackout. P: play/pause current clip. C: command cards. Z: full-size figure. Digits + Enter: jump to physical page. Hashes accept physical page numbers or named anchors such as #F5 and #B7. Click a feature video to pause at a question.','','## Spoken delivery','']
def mm(s):return f'{s//60:02d}:{s%60:02d}'
for s in slides:
 if s['kind'] not in ['main','clip']:continue
 lines+=['### '+s['label']+' · '+s['title'], '',f"{mm(s['clock'])}–{mm(s['clock']+s['secs'])} · Section {s['sec']} · {mm(s['secs'])}",'',s['script'],'','Transition: '+s['transition'],'','If asked: '+ ' · '.join('→ '+x for x in s['refs']),'']
lines+=['## Q&A backup map','','| Backup | Question | Spoken answer |','|---|---|---|']
for s in slides:
 if s['kind']=='back':lines.append('| '+s['id']+' | '+s['title']+' | '+s['script'].replace('|','/')+' |')
lines+=['','## CI/CD walk-through command cards','','```sh','gh run view 40344231052 -R Collaboration95/rewind-app','gh api repos/Collaboration95/rewind-app/branches/dev/protection','gh run view 40344230832 -R Collaboration95/rewind-app','gh api repos/Collaboration95/rewind-app/actions/runs/40344230832/artifacts','gh attestation verify --repo Collaboration95/rewind-app rewind-release.tar','```','','Saved artifacts: `../pipeline-run-40344230832/security/` and `../pipeline-run-40344230832/zap/`. Hosted health: `https://d2m6kz76y4kuvm.cloudfront.net/api/health`.','','## Source register','','- Shared brief: scope, equal effort, delivery surface, five-section timing.','- Audits B1/B2: use cases, analysis, module mapping, design and patterns.','- Audit E: dated test inventory, coverage and red/green retry replay.','- records/TEAM.md and AGILE.md: team, effort, milestones, events and dated open register.','- records/FINDINGS.md: technical defects and repairs; later pipeline artifacts establish the delivered scan/deployment state.','- PIPELINE-ARTIFACTS.md and run 40344230832: exact-image inventory, manifest, scan and provenance flow.','- load-test/METHODOLOGY.md and RESULTS.md: hosted measurement, separate confirmation and capacity projection.','']
assert clock==2280,(clock,'expected 38 minutes')
(D/'SCRIPT.md').write_text('\n'.join(lines))
missing_figs=sorted({id for id in re.findall(r'data-figure="([^"]+)"',document) if not (D/'uml'/f'{id}.svg').exists()})
missing_clips=[s['id']+': '+re.search(r'data-clip="([^"]+)"',s['body']).group(1) for s in slides if s['kind']=='clip' and not (D/re.search(r'data-clip="([^"]+)"',s['body']).group(1)).resolve().exists()]
if not (D/'clips/ci-cd-40344230832.mp4').exists():missing_clips.append('CI/CD: clips/ci-cd-40344230832.mp4')
(D/'PLACEHOLDERS.md').write_text('# Parallel-agent integration slots\n\nRe-run `python3 build_deck.py` after assets arrive, then export the PDF.\n\n## UML\n\n'+ ('\n'.join('- `uml/'+x+'.svg`' for x in missing_figs) or 'All referenced SVGs are present.')+'\n\n## Clips\n\n'+ ('\n'.join('- '+x for x in missing_clips) or 'All clip files are present.')+'\n')
(D/'README.md').write_text('''# Rewind deck

Run `./serve.sh` and open `http://127.0.0.1:8778/deck/deck.html`. The server serves presentation-prep so the sibling videos directory is reachable. Arrow keys navigate; N notes; O overview; F fullscreen; B blackout; P clip playback; C command cards; Z full-size figure; digits + Enter jump. Named hashes include #s9, #F5 and #B7.

Twenty main narrative frames, twelve feature inserts, twelve Q&A backups. SCRIPT.md totals 38 minutes. OUTLINE.md maps the brief to frames. PLACEHOLDERS.md lists current parallel-agent asset slots.

`python3 build_deck.py` rebuilds the HTML and script, refreshes final-clip posters, and discovers every SVG in uml/. It reads shared records but writes only inside deck/. It does not edit diagram or video sources. Keep the final clips in ../videos/clips/ and the pipeline recording in clips/ci-cd-40344230832.mp4.

Framework fork: CSS and JS copied from dc2-rescue/project-documentation/presentation/site/deck.html, with the PDF palette and layout applied as overrides. Counters and five-section progress are generated. The overview supports clickable frames; videos load on activation and pause when leaving the frame. PDF uses a 1280×720 print stage.

Export with `./export.sh`. The PDF and 60-dpi page rasterisations are under out/.
''')
print(json.dumps({'physical_frames':len(slides),'main_frames':20,'feature_inserts':12,'backups':back,'talk_seconds':clock,'svg_present':len(list((D/'uml').glob('*.svg'))),'missing_figures':missing_figs,'missing_clips':missing_clips},indent=2))
