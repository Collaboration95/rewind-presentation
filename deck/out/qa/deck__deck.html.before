<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rewind · SWE5006 Team 14 · 27 October 2026</title><style>
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#000;overflow:hidden;font-family:-apple-system,"Helvetica Neue",Arial,sans-serif;color:#0f172a}
#stage{position:absolute;left:0;top:0;width:1280px;height:720px;transform-origin:0 0;background:#fff;overflow:hidden}
#bar{position:absolute;left:0;top:0;height:6px;width:0;background:#2563EB;z-index:5}
.slide{position:absolute;inset:0;padding:30px 50px 0;display:flex;flex-direction:column;background:#fff;opacity:0;visibility:hidden}
.slide.active{opacity:1;visibility:visible}
h1{font-size:44px;line-height:1.1;margin:0 0 16px;font-weight:800;letter-spacing:-.5px;min-height:48px}
.body{flex:1;position:relative;min-height:0;margin-bottom:76px;display:flex;flex-direction:column;justify-content:center}
.foot{position:absolute;left:0;right:0;bottom:0;height:38px;border-top:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;padding:0 50px;font-size:16px;color:#64748b;background:#fff}
.fr{display:flex;align-items:center;gap:18px}.pl{font-size:13px;color:#64748b;text-decoration:none}.pl:hover{text-decoration:underline;color:#2563EB}
.sec{position:absolute;top:12px;right:50px;font-size:18px;font-weight:700;color:#64748b}
.notes{display:none}
.row{display:flex;align-items:center;gap:14px}
.col{display:flex;flex-direction:column;gap:14px}
.fill{flex:1}
.wrap{flex-wrap:wrap}
.cc{justify-content:center;align-items:center}
.box{border:3px solid;border-radius:12px;padding:10px 18px;font-size:26px;font-weight:700;text-align:center;line-height:1.2}
.sub{display:block;font-size:24px;font-weight:500;opacity:.9;margin-top:2px}
.m{border-color:#2563EB;background:#DBEAFE;color:#1e3a8a}
.p{border-color:#D97706;background:#FEF3C7;color:#78350f}
.c{border-color:#059669;background:#ECFDF5;color:#064e3b}
.i{border-color:#64748B;background:#F1F5F9;color:#334155}
.x{border-color:#D55E00;background:#fff4ec;color:#7c2d00}
.g{border-color:#94a3b8;border-style:dashed;background:#fff;color:#64748b}
.k{border-color:#0f172a;background:#0f172a;color:#fff}
.chip{display:inline-block;border:3px solid;border-radius:999px;padding:6px 18px;font-size:24px;font-weight:700}
.chip.mono,.mono{font-family:Menlo,monospace;font-weight:600}
.ar{position:relative;width:46px;height:0;border-top:4px solid #64748b;flex:none;margin:0 6px}
.ar::after{content:"";position:absolute;right:-3px;top:-11px;border-left:15px solid #64748b;border-top:9px solid transparent;border-bottom:9px solid transparent}
.ar.d{border-top-style:dashed}
.ar.o{border-top-color:#D55E00}.ar.o::after{border-left-color:#D55E00}
.ar.gr{border-top-color:#059669}.ar.gr::after{border-left-color:#059669}
.ar.l{transform:scaleX(-1)}
.ar.v{width:0;height:42px;border-top:0;border-left:4px solid #64748b;margin:4px 0;align-self:center}
.ar.v::after{right:auto;top:auto;left:-11px;bottom:-3px;border-left:9px solid transparent;border-right:9px solid transparent;border-top:15px solid #64748b;border-bottom:0}
.ar.v.o{border-left-color:#D55E00}.ar.v.o::after{border-top-color:#D55E00}
.cap{font-size:26px;color:#475569;line-height:1.25}
.cap.c1{text-align:center}
.lbl{font-size:24px;font-weight:700;color:#475569}
.big{font-size:104px;font-weight:800;line-height:1}
.big.pass{color:#059669}.big.miss{color:#D55E00}
.pass{color:#059669}.miss{color:#D55E00}
.tile{border:3px solid;border-radius:16px;padding:20px 24px;flex:1;font-size:30px;font-weight:700;line-height:1.2}
.num{display:inline-flex;width:48px;height:48px;border-radius:50%;background:#0f172a;color:#fff;font-weight:800;font-size:28px;align-items:center;justify-content:center;margin-bottom:10px}
.card{display:flex;flex-direction:column;gap:12px}
.card .ad{font:700 30px Menlo,monospace;color:#475569}
.band{display:flex;border-radius:12px;overflow:hidden;border:2px solid #cbd5e1}
.band .kk{width:176px;flex:none;background:#0f172a;color:#fff;font-size:24px;font-weight:700;display:flex;align-items:center;padding:0 16px}
.band .v{padding:14px 20px;font-size:30px;font-weight:700}
.tbl{border-collapse:collapse;font-size:24px;width:100%}
.tbl th{text-align:left;color:#475569;font-size:24px;border-bottom:3px solid #0f172a;padding:6px 12px}
.tbl td{padding:10px 12px;border-bottom:1px solid #e2e8f0;vertical-align:top}
.stage-row{display:flex;gap:16px;align-items:flex-start;margin-bottom:12px}
.stage-row .sl{width:200px;flex:none;font-size:24px;font-weight:800;color:#fff;background:#0f172a;border-radius:10px;padding:8px 12px;text-align:center}
.stage-row .chips{display:flex;flex-wrap:wrap;gap:8px;flex:1}
.stage-row .chips .chip{font-size:24px;padding:4px 14px;border-width:2px;border-radius:10px;font-weight:600}
.dia{width:1180px;display:block}
.dia text{font-family:-apple-system,"Helvetica Neue",Arial,sans-serif;font-size:24px;fill:#0f172a;text-anchor:middle;font-weight:700}
.dia text.s{font-size:24px;font-weight:500}
.dia text.l{text-anchor:start}
.dia text.mo{font-family:Menlo,monospace;font-weight:600}
.dia .sb{stroke-width:3}
.dia .sb.m{fill:#DBEAFE;stroke:#2563EB}.dia .sb.p{fill:#FEF3C7;stroke:#D97706}.dia .sb.c{fill:#ECFDF5;stroke:#059669}
.dia .sb.i{fill:#F1F5F9;stroke:#64748B}.dia .sb.x{fill:#fff4ec;stroke:#D55E00}.dia .sb.g{fill:#fff;stroke:#94a3b8;stroke-dasharray:8 6}
.dia .sb.zm{fill:#f5f9ff;stroke:#2563EB;stroke-dasharray:none}.dia .sb.zp{fill:#fffaf0;stroke:#D97706}.dia .sb.zi{fill:#f8fafc;stroke:#64748B;stroke-dasharray:10 6}
.dia .ln{stroke:#64748B;stroke-width:3.5;fill:none}.dia .ln.d{stroke-dasharray:9 7}.dia .ln.o{stroke:#D55E00}.dia .ln.gr{stroke:#059669}.dia .ln.life{stroke:#cbd5e1;stroke-width:3;stroke-dasharray:6 6}
.clip{position:relative;width:860px;height:484px;background:#0f172a;border-radius:12px;overflow:hidden;cursor:pointer;flex:none}
.clip video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;display:none}
.clip.ready video{display:block}
.clip .ph{position:absolute;inset:14px;border:3px dashed #475569;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;color:#e2e8f0;font-size:30px;font-weight:700;text-align:center;padding:0 40px}
.clip .ph small{font-size:24px;font-weight:500;color:#94a3b8}
.clip.ready .ph{display:none}
.tri{width:0;height:0;border-left:44px solid #e2e8f0;border-top:28px solid transparent;border-bottom:28px solid transparent}
.clip .pb{position:absolute;left:50%;top:50%;margin:-50px 0 0 -50px;width:100px;height:100px;border-radius:50%;background:rgba(15,23,42,.7);display:none;align-items:center;justify-content:center}
.clip .pb .tri{border-left:34px solid #fff;border-top:22px solid transparent;border-bottom:22px solid transparent;margin-left:8px}
.clip.ready:not(.playing) .pb{display:flex}
.clip .cb{position:absolute;left:0;bottom:0;height:6px;width:0;background:#2563EB}
.clipid{font:700 28px Menlo,monospace;color:#475569}
#notes{position:fixed;left:0;right:0;bottom:0;height:230px;overflow:auto;background:#0f172a;color:#e2e8f0;font-size:19px;line-height:1.35;padding:12px 28px;display:none;z-index:20}
#notes.on{display:block}
#notes ul{margin:4px 0;padding-left:24px}#notes b{color:#fff}
#ov{position:fixed;inset:0;background:rgba(15,23,42,.96);overflow:auto;display:none;z-index:30;padding:20px}
#ov.on{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;align-content:start}
#ov .th{position:relative;width:100%;aspect-ratio:16/9;background:#fff;overflow:hidden;border-radius:6px;cursor:pointer;border:3px solid transparent}
#ov .th.cur{border-color:#2563EB}
#ov .th .in{position:absolute;left:0;top:0;width:1280px;height:720px;transform-origin:0 0;pointer-events:none}
#ov .th .n{position:absolute;right:6px;bottom:4px;z-index:2;background:#0f172a;color:#fff;font:700 13px Menlo,monospace;padding:2px 6px;border-radius:4px}
#ov .slide{opacity:1;visibility:visible}
#black{position:fixed;inset:0;background:#000;display:none;z-index:40}
#black.on{display:block}
#hud{position:fixed;right:14px;top:10px;z-index:25;font:700 22px Menlo,monospace;color:#fff;background:rgba(15,23,42,.85);padding:4px 12px;border-radius:6px;display:none}
.dv{align-items:center;justify-content:center;text-align:center}
@media print{
html,body{background:#fff;overflow:visible;height:auto}
#stage{position:static;transform:none!important;width:1280px;height:auto;overflow:visible}
.slide{position:relative;visibility:visible!important;opacity:1!important;width:1280px;height:720px;break-after:page;page-break-after:always;overflow:hidden}
#notes,#ov,#black,#bar,#hud{display:none!important}
.clip video{display:none!important}.clip .ph{display:flex!important}.clip .pb{display:none!important}
@page{size:1280px 720px;margin:0}
}


:root{--cream:#F5F2E9;--navy:#14202B;--ink:#14202B;--muted:#50606a;--orange:#B4501A;--pm:#B4501A;--sad:#7255B7;--sdp:#2C64A0;--testing:#9a3d62;--devsecops:#247B72;--demo:#367348}
html,body{color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif}
#stage,.slide{background:var(--cream)}.slide{padding:43px 64px 0}.slide h1{font-size:37px;line-height:1.13;min-height:44px;letter-spacing:-.7px;margin:13px 0 17px;font-weight:750}.kicker{font:600 15px Menlo,monospace;letter-spacing:1.15px;color:var(--accent);text-transform:uppercase}
.body{margin-bottom:64px;justify-content:flex-start}.split{display:grid;grid-template-columns: 2.03fr 1fr;gap:28px;height:100%;align-items:stretch;min-height:0}.figure{background:#fff;border:1px solid #deded6;border-radius:9px;min-width:0;padding:16px;overflow:hidden;position:relative;margin:0;display:flex;flex-direction:column;justify-content:center}.figuretitle,figcaption{font:600 14px Menlo,monospace;letter-spacing:.1px;color:#53616a;margin:0 0 12px;flex-shrink:0}.diagram img{width:100%;height:0;flex:1;object-fit:contain;min-height:0}.fig-placeholder{position:absolute;inset:60px 22px 24px;display:flex;gap:20px;flex-direction:column;justify-content:center;align-items:center;text-align:center;border:2px dashed #d2d5d1;border-radius:6px;background:#fafaf7}.fig-placeholder span{font:15px Menlo,monospace;color:#776d8e}.fig-placeholder strong{font-size:28px;max-width:520px}.fig-placeholder code{font:18px Menlo,monospace;color:#66727a}.diagram.loaded .fig-placeholder{display:none}.explain{align-self:center;font-size:24px;line-height:1.3;color:var(--muted)}.explain p{margin:0 0 23px}.explain p:last-child{margin:0}.explain b{color:var(--ink)}.foot{left:64px;right:64px;padding:0;height:47px;background:transparent;border-top:1px solid #d7d7ce;color:#5e6b72;font:12px Menlo,monospace;gap:20px}.foot .source{max-width:1000px}.counter{flex:none;font:600 15px Menlo,monospace}.section-progress{position:absolute;top:0;left:0;width:100%;display:flex;height:6px;gap:3px}.section-progress span{flex:1;background:#deded4}.section-progress .done,.section-progress .current{background:var(--accent)}.section-progress .done{opacity:.5}#bar{top:auto;bottom:0;height:3px;background:var(--accent)!important}
.slide.cover{background:var(--navy);color:var(--cream);padding-top:52px}.cover .kicker{color:#eea16d}.cover h1{font-size:30px;color:#dbe2de;font-weight:450;margin:18px 0 0}.cover .body{justify-content:center}.cover-word{font-size:125px;font-weight:750;letter-spacing:-6px;line-height:1.1}.cover-word span{color:#e69b63;display:inline-block;margin-left:28px;font-size:115px}.cover-sub{font-size:31px;color:#d3dcd8;margin:23px 0}.cover-loop{display:flex;gap:29px;align-items:center;font:22px Menlo,monospace;color:#efe5cd;margin-top:26px}.cover-loop i{font-size:35px;color:#d08c5d;font-style:normal}.cover-meta{font:17px/1.7 Menlo,monospace;margin-top:52px;color:#a7b6b8}.cover .foot{border-color:#4c585e;color:#a7b6b8}.cover .section-progress span{background:#3c484b}
h2{font-size:29px;letter-spacing:-.4px;line-height:1.2;margin:11px 0}.product-loop,.journey-map{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.product-loop div,.journey-map div{padding:25px 8px}.product-loop em,.journey-map em,.bug-steps em{font:18px Menlo,monospace;color:var(--accent);font-style:normal}.product-loop p,.journey-map p{font-size:24px;line-height:1.4;color:var(--muted)}.rule{border-top:1px solid #e1e0d7;margin-top:20px;padding:24px 8px;font-size:23px;color:var(--orange)}
.data{width:100%;border-collapse:collapse;font-size:23px;line-height:1.2;table-layout:auto}.data th{text-align:left;font-size:16px;font-family:Menlo,monospace;color:#52616a;border-bottom:2px solid #9ba5a4;padding:10px 10px 12px}.data td{padding:13px 10px;border-bottom:1px solid #d7d9d2;vertical-align:top}.data tr:last-child td{border-bottom:0}.data td:first-child{font-weight:650}.data.testing{font-size:19px;table-layout:fixed}.data.testing th:nth-child(1){width:14%}.data.testing th:nth-child(2){width:20%}.data.testing th:nth-child(3){width:14%}.data.testing th:nth-child(4){width:22%}.data.testing th:nth-child(5){width:9%}.data.testing th:nth-child(6){width:21%}.data.testing th{font-size:14px}.data.testing td{padding:7px 7px;line-height:1.15}.data.testing td:nth-child(5){font:600 15px Menlo,monospace;color:#247b72}.metric-row{display:flex;gap:36px;margin:14px 8px 0}.metric-row div{flex:1}.metric-row strong{font-size:33px;color:#9a3d62}.metric-row span{display:block;font-size:19px;color:#5d686d;margin-top:4px}.pm-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:30px;min-height:0;flex:1}.pm-grid .data{font-size:20px}.pm-grid .data td{padding:10px}.pm-grid p{font-size:21px;line-height:1.26;margin:0 0 15px}.pm-grid .figure{margin-top:9px;padding:10px;height:161px}.pm-grid svg{width:100%;height:100%}.pm-grid svg text{font-size:22px;fill:#4a5c65;font-family:-apple-system,Arial}.status-strip{font-size:16px;line-height:1.4;margin-top:11px;padding:13px 0 0;border-top:1px solid #c7cdc6}.status-strip b{font:600 14px Menlo,monospace;color:#b4501a;margin-right:10px}.status-strip span{display:block;color:#68747a;font-size:14px;margin-top:5px}
.bug-steps{display:flex;flex-direction:column;gap:13px}.bug-steps>div{border-bottom:1px solid #ddd;padding:12px 7px}.bug-steps p{font-size:28px;margin:8px 0}.regression{display:flex;justify-content:space-around;align-items:center;font-size:22px;margin-top:20px}.regression b{display:block;font:600 31px Menlo,monospace;margin-top:12px}.regression span:first-child b{color:#aa443b}.regression span:last-child b{color:#247b72}.regression i{font-size:38px;font-style:normal}.artifact-layout{display:grid;grid-template-columns:1.15fr 1fr;gap:26px;height:100%}.data.artifacts{font-size:20px}.data.artifacts td{padding:11px 9px}.data.security{font-size:23px}.data.security td{padding:15px 10px}.data.security td:nth-child(3){max-width:370px}.takeaway{font-size:24px;color:#b4501a;margin-top:21px}.data.findings{font-size:22px}.data.findings td{padding:13px 10px}pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:normal;font:17px/1.65 Menlo,monospace;margin:0;color:#273f4c}.image-counts{font:20px/1.7 Menlo,monospace;margin-top:22px;border-top:1px solid #ddd;padding-top:20px}.data.walk{font-size:23px}.data.walk td{padding:16px 9px}.run-clock{display:flex;gap:20px;margin-top:22px}.run-clock div{flex:1;font-size:17px;color:#52616a}.run-clock b{display:block;font:600 26px Menlo,monospace;color:#247b72;margin-bottom:8px}.demo-actions{display:flex;gap:15px;align-items:center;margin-top:23px;font-size:17px;color:#576b72}button{border:1px solid #c5cac4;background:transparent;border-radius:5px;padding:8px 12px;color:#38545c;font:14px Menlo,monospace;cursor:pointer}button:hover{background:#e0e6df}.pipeline-overlay{position:absolute;inset:0;background:#f5f2e9;z-index:4;padding:8px;display:flex;gap:12px;flex-direction:column;align-items:center}.pipeline-overlay[hidden]{display:none}.pipeline-overlay .clip{width:850px;height:478px}.commands{position:absolute;inset:0;background:#f5f2e9;padding:18px;z-index:3}.commands pre{font-size:21px;line-height:1.8}.commands h2{font-size:26px}.commands p{font-size:23px}
.clip-layout{grid-template-columns:2.03fr 1fr}.clip-layout .clip{width:100%;height:100%;border-radius:9px;background:#14202b}.clip .poster{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#14202b}.clip .ph{font-size:26px;gap:21px;border-width:1px;border-color:#637076}.clip .ph small{font:16px Menlo,monospace;word-break:break-word}.clip.ready .poster{display:none}.clip .poster+.ph{background:rgba(20,32,43,.8)}.clip-hint{font:15px/1.6 Menlo,monospace;color:#738076;margin-top:27px}.clip video{z-index:2}.clip .pb,.clip .cb{z-index:3}.clip .cb{background:#e09c62}.clip .poster{opacity:.45}.clip-layout .clip.ready{background:#000}
.perf-layout{display:grid;grid-template-columns:1fr 1.15fr;gap:25px;height:100%}.perf-layout .figure{padding:15px;justify-content:flex-start}.perf-layout .data{font-size:24px}.perf-layout .data td{padding:12px}.perf-layout svg{height:270px;width:100%}.perf-layout svg text{font:20px -apple-system,Arial;fill:#53636a}.perf-layout .explain{font-size:19px}.perf-layout>div>p{font-size:20px;line-height:1.3}.perf-layout>div>p b{color:#14202b}.perf-layout>div>p{margin:14px 0}.perf-method{font-size:19px!important;color:#52616a;line-height:1.4!important}.confirmation{border-left:4px solid #247b72;padding-left:15px;font-size:20px;line-height:1.5;margin-top:13px}.chart img{width:100%;height:calc(100% - 30px);object-fit:contain}.backup-bottom{display:flex;gap:25px;margin-top:25px;font-size:21px}.backup-bottom p{flex:1;margin:0}.chart-switches{display:flex;gap:10px;margin-top:10px}.command{font-size:18px;border-top:1px solid #ccc;margin-top:22px;padding-top:18px}.figure-switches{position:absolute;bottom:-24px;left:0;display:flex;gap:8px}.figure-switches button{font-size:11px;padding:4px 7px}.alternate-view{position:absolute;inset:32px 16px 16px;background:#fff;z-index:2;display:flex;align-items:center;justify-content:center}.alternate-view[hidden]{display:none}.alternate-view img{width:100%;height:100%;object-fit:contain}.body:has(.alternate-view:not([hidden]))>.split>.figure{visibility:hidden}.body>.alternate-view{right:34%;border:1px solid #deded6;border-radius:9px;padding:14px}.figure-switches{z-index:4}#figure-zoom{position:fixed;inset:0;background:#f5f2e9;z-index:70;padding:55px 20px 20px;display:flex;flex-direction:column}.zoom-close{position:absolute;right:20px;top:12px;background:#fff}.zoom-scroll{overflow:auto;flex:1;background:#fff;border-radius:8px;border:1px solid #d3d8d2}.zoom-scroll img{display:block;width:auto;height:auto;min-width:1100px;margin:25px auto}.diagram{cursor:zoom-in}#notes{font-family:-apple-system,Arial;font-size:20px}#notes p{margin:6px 0}#ov .th{background:#f5f2e9}#ov .th .in .slide{padding-top:43px}.clip.print-poster .ph{background:transparent}.clip.print-poster .ph>*{visibility:hidden}.clip.print-poster .poster{opacity:1}
@media print{html,body{print-color-adjust:exact;-webkit-print-color-adjust:exact}.slide{padding:43px 64px 0}.section-progress{display:flex!important}.foot{background:transparent}.clip .poster{opacity:1!important;display:block!important;z-index:2}.clip .ph{z-index:1;background:#14202b}.clip .pb,.chart-switches,.demo-actions,.pipeline-overlay,.commands,.figure-switches,.alternate-view,#figure-zoom{display:none!important}.diagram .fig-placeholder{background:#fafaf7}.cover{background:#14202b!important}.cover .foot{background:transparent}.slide:last-child{break-after:auto}}
</style></head><body><div id="stage"><div id="bar"></div><section class="slide cover" id="s1" data-kind="main" data-num="1" data-main="1" data-sec="1" data-time="15" style="--accent:var(--pm)"><div class="section-progress" aria-label="Five section progress"><span class="current" title="PM"></span><span class="" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">PM · SWE5006 / TEAM 14</div><h1>A month of moments. One film.</h1><div class="body"><div class="cover-word">Rewind<span>↶</span></div><div class="cover-sub">Small private groups. Sealed moments. A shared reveal.</div><div class="cover-loop"><span>Contribute</span><i>→</i><span>Seal</span><i>→</i><span>Compile</span><i>→</i><span>Watch</span></div><div class="cover-meta">SWE5006 · TEAM 14 · 27 OCTOBER 2026<br>Gopal Guruprasath</div></div><div class="foot"><span class="source">BRIEF-SHARED.md · 27 Oct 2026</span><span class="counter"></span></div><aside class="notes"><b>0:15 · Section 1 · PM</b><p>Say: Rewind gives a small group one shared film from a month of everyday moments.</p><p>Transition: First, the problem and the product boundary.</p><p>If asked: → B10</p></aside></section><section class="slide " id="s2" data-kind="main" data-num="2" data-main="2" data-sec="1" data-time="55" style="--accent:var(--pm)"><div class="section-progress" aria-label="Five section progress"><span class="current" title="PM"></span><span class="" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">PM · SECTION 1</div><h1>Everyday moments need a shared reason to return.</h1><div class="body"><div class="split "><div class="figure"><div class="figuretitle">Product view · private-group journey</div><div class="product-loop"><div><em>01</em><h2>Contribute</h2><p>Photo or video<br>2–10 members</p></div><div><em>02</em><h2>Seal</h2><p>Private until reveal<br>28-day cycle</p></div><div><em>03</em><h2>Watch</h2><p>One group film<br>24-hour premiere</p></div></div><div class="rule">5 moments / 30 seconds per member each week</div></div><div class="explain"><p><b>Problem.</b> Photos disappear into busy chats; shared memories become scattered.</p><p><b>Scope.</b> Accounts, invitation, capture, chat, reminders, film and Archive in a web/PWA product.</p><p><b>Value.</b> A bounded contribution habit leads to one shared reveal.</p></div></div></div><div class="foot"><span class="source">audit/F1-system-demo.md §1 · product rules</span><span class="counter"></span></div><aside class="notes"><b>0:55 · Section 1 · PM</b><p>Say: The problem is fragmented memories in busy group chats.</p><p>Say: The product uses small groups, a 28-day cycle and weekly contribution limits.</p><p>Say: Photo and video both stay; the iPhone experience is the Home Screen app.</p><p>Transition: The four sprints show how we delivered this boundary.</p><p>If asked: → B1 · → B10</p></aside></section><section class="slide " id="s3" data-kind="main" data-num="3" data-main="3" data-sec="1" data-time="140" style="--accent:var(--pm)"><div class="section-progress" aria-label="Five section progress"><span class="current" title="PM"></span><span class="" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">PM · SECTION 1</div><h1>Four sprints delivered the hosted private-group journey.</h1><div class="body"><div class="pm-grid"><div><table class="data "><thead><tr><th>Sprint</th><th>Milestone</th></tr></thead><tbody><tr><td>0 · 1–12 Sep</td><td>Runtime foundation</td></tr><tr><td>1 · 13–26 Sep</td><td>Integrated capture-to-film</td></tr><tr><td>2 · 27 Sep–10 Oct</td><td>Real accounts · S3 · PostgreSQL · Cognito</td></tr><tr><td>3 · 11–24 Oct</td><td>Stability · recovery · regression tests</td></tr></tbody></table><div class="figure"><svg viewBox="0 0 700 184" aria-label="Velocity: issues closed by sprint"><text x="10" y="24">Velocity · issues closed in each sprint window</text><rect x="72" y="121.4" width="78" height="28.6" fill="#247b72"/><text x="111" y="109.4" text-anchor="middle">44</text><text x="111" y="178" text-anchor="middle">S0</text><rect x="226" y="85.0" width="78" height="65.0" fill="#247b72"/><text x="265" y="73.0" text-anchor="middle">100</text><text x="265" y="178" text-anchor="middle">S1</text><rect x="380" y="55.75" width="78" height="94.25" fill="#247b72"/><text x="419" y="43.75" text-anchor="middle">145</text><text x="419" y="178" text-anchor="middle">S2</text><rect x="534" y="130.5" width="78" height="19.5" fill="#247b72"/><text x="573" y="118.5" text-anchor="middle">30</text><text x="573" y="178" text-anchor="middle">S3</text></svg></div></div><div><p><b>Team · equal effort.</b> Nguyen Kim Long · Gopal Guruprasath · Jiang Jiayu · Phan Mai Tan Loi · Sang Haoxiang.<br><strong>20% each · agreed split.</strong></p><p><b>Done.</b> Outcome checked + fast tests + green Quality + merge to dev. Batch reviews resolve blocking findings.</p><p><b>Ceremonies.</b> Project planning; Sprint Planning and Review each sprint.</p><p><b>Retro → next sprint.</b> Integration gaps in S1 → real adapters in S2; stale state in S2 → interaction tests in S3.</p></div></div><div class="status-strip"><b>26 OCT · OPEN</b> #587 focused runner · #588 chat labels · #527 Safari/PWA integration · #362 report assembly <span>Full delivery register → B10</span></div></div><div class="foot"><span class="source">records/TEAM.md · AGILE.md · charts/velocity.png · open issues checked 26 Oct</span><span class="counter"></span></div><aside class="notes"><b>2:20 · Section 1 · PM</b><p>Say: The four milestones move from a runnable skeleton to real accounts and stabilisation.</p><p>Say: Each of our five members has an agreed twenty-percent effort share.</p><p>Say: Planning and reviews happened each sprint; retrospective actions changed the next sprint’s checks.</p><p>Transition: The use cases now give that scope a formal boundary.</p><p>If asked: → B10</p></aside></section><section class="slide " id="s4" data-kind="main" data-num="4" data-main="4" data-sec="2" data-time="33" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>Fourteen use cases follow one private-group journey.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="uc-model"><figcaption>Use case view · UC01–UC14 · private-group journey</figcaption><img src="uml/uc-model.svg" alt="Use case view · UC01–UC14 · private-group journey" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Use case view · UC01–UC14 · private-group journey</strong><code>uml/uc-model.svg</code></div></figure><div class="explain"><p><b>Actors.</b> Members contribute and watch; group owners manage membership and settings.</p><p><b>System boundary.</b> Cognito, S3, web push and the scheduler participate through explicit interfaces.</p><p><b>Critical path.</b> CU-B joins UC07 cycle closure to UC08 film compilation and reveal.</p></div></div><div class="alternate-view" data-view="uc-model-access" hidden><img src="uml/uc-model-access.svg" alt="UML view · uc model access"></div><div class="figure-switches"><button data-alt-view="uc-model-cycle">uc model cycle</button><button data-alt-view="uc-model-capture">uc model capture</button><button data-alt-view="uc-model-access">uc model access</button><button data-default-view="true">Overview</button></div><div class="alternate-view" data-view="uc-model-capture" hidden><img src="uml/uc-model-capture.svg" alt="UML view · uc model capture"></div><div class="alternate-view" data-view="uc-model-cycle" hidden><img src="uml/uc-model-cycle.svg" alt="UML view · uc model cycle"></div></div><div class="foot"><span class="source">audit/B1-analysis.md · uc-model</span><span class="counter"></span></div><aside class="notes"><b>0:33 · Section 2 · SAD</b><p>Say: Read the human goals inside the boundary before following implementation details.</p><p>Say: CU-B is close cycle, compile and release the group film.</p><p>Transition: The logical view shows where those responsibilities live.</p><p>If asked: → B1 · → B3</p></aside></section><section class="slide " id="s5" data-kind="main" data-num="5" data-main="5" data-sec="2" data-time="39" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>One Node application keeps rules close to transactions.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="arch-logical"><figcaption>Logical view · private-group application and adapters</figcaption><img src="uml/arch-logical.svg" alt="Logical view · private-group application and adapters" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Logical view · private-group application and adapters</strong><code>uml/arch-logical.svg</code></div></figure><div class="explain"><p><b>Monolith.</b> One Node/TypeScript application owns policy and transaction boundaries.</p><p><b>Persistence.</b> Hosted PostgreSQL stores durable group, cycle and job state; S3 holds private media.</p><p><b>Adapters.</b> Cognito identity, media storage and browser capture sit behind named interfaces.</p></div></div></div><div class="foot"><span class="source">audit/B1-analysis.md · B2-design.md · ADR-0003</span><span class="counter"></span></div><aside class="notes"><b>0:39 · Section 2 · SAD</b><p>Say: We chose a modular monolith because the private-group rules share transactions.</p><p>Say: PostgreSQL stores durable state and S3 stores media.</p><p>Say: Interfaces isolate identity, storage and capture differences.</p><p>Transition: Now map the analysis responsibilities onto that implementation.</p><p>If asked: → B4 · → B5 · → B9</p></aside></section><section class="slide " id="s6" data-kind="main" data-num="6" data-main="6" data-sec="2" data-time="45" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>Analysis responsibilities become named implementation modules.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="a2d-cycle"><figcaption>Analysis → design view · CU-B close, compile, reveal</figcaption><img src="uml/a2d-cycle.svg" alt="Analysis → design view · CU-B close, compile, reveal" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Analysis → design view · CU-B close, compile, reveal</strong><code>uml/a2d-cycle.svg</code></div></figure><div class="explain"><p><b>Analysis.</b> Boundary objects receive interaction; controls coordinate the use case; entities retain business state.</p><p><b>Design.</b> The scheduler, lifecycle and compilation modules implement those responsibilities.</p><p><b>Trace.</b> Cycles, media jobs and frozen compilation inputs provide the persistent record.</p></div></div></div><div class="foot"><span class="source">audit/B1-analysis.md · CU-B mapping</span><span class="counter"></span></div><aside class="notes"><b>0:45 · Section 2 · SAD</b><p>Say: The analysis model names responsibilities before implementation.</p><p>Say: The design model maps those responsibilities to real modules and tables.</p><p>Say: Function modules are labelled as modules, not invented classes.</p><p>Transition: The hardest design problem is safely repeating this background work.</p><p>If asked: → B1 · → B2</p></aside></section><section class="slide " id="s7" data-kind="main" data-num="7" data-main="7" data-sec="2" data-time="54" style="--accent:var(--sdp)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SDP · SECTION 2</div><h1>Durable claims keep repeated cycle work safe.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="class-cycle"><figcaption>Design class view · CU-B · durable job and claim roles</figcaption><img src="uml/class-cycle.svg" alt="Design class view · CU-B · durable job and claim roles" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Design class view · CU-B · durable job and claim roles</strong><code>uml/class-cycle.svg</code></div></figure><div class="explain"><p><b>Problem.</b> Ticks repeat; a worker may stop or complete after its claim expires.</p><p><b>Candidates.</b> Polling alone; a hierarchy of State or Command objects; persisted state with durable jobs.</p><p><b>Chosen.</b> Persisted lifecycle + one durable job + lease/generation checks at finalisation.</p></div></div></div><div class="foot"><span class="source">audit/B1-analysis.md · B2-design.md · server/src/jobs/compilation.ts</span><span class="counter"></span></div><aside class="notes"><b>0:54 · Section 2 · SDP</b><p>Say: Polling finds work but does not make repeated execution safe.</p><p>Say: We compared polling alone and object hierarchies with persisted state and durable jobs.</p><p>Say: The implementation uses durable claims and rejects stale completion.</p><p>Transition: The sequence shows where those checks happen.</p><p>If asked: → B2 · → B7 · → B8 · → B9</p></aside></section><section class="slide " id="s8" data-kind="main" data-num="8" data-main="8" data-sec="2" data-time="57" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>A repeated tick reuses work and fences stale completion.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="seq-cycle"><figcaption>Sequence view · CU-B · close cycle → compile → reveal</figcaption><img src="uml/seq-cycle.svg" alt="Sequence view · CU-B · close cycle → compile → reveal" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Sequence view · CU-B · close cycle → compile → reveal</strong><code>uml/seq-cycle.svg</code></div></figure><div class="explain"><p><b>Close.</b> The lifecycle transition creates the successor and queues compilation atomically.</p><p><b>Compile.</b> The worker claims durable work and renders the frozen input set.</p><p><b>Finalise.</b> A current claim publishes the film; duplicate or stale paths follow the alternatives.</p></div></div><div class="alternate-view" data-view="seq-cycle-compile" hidden><img src="uml/seq-cycle-compile.svg" alt="UML view · seq cycle compile"></div><div class="figure-switches"><button data-alt-view="seq-cycle-release">seq cycle release</button><button data-alt-view="seq-cycle-compile">seq cycle compile</button><button data-default-view="true">Overview</button></div><div class="alternate-view" data-view="seq-cycle-release" hidden><img src="uml/seq-cycle-release.svg" alt="UML view · seq cycle release"></div></div><div class="foot"><span class="source">audit/B1-analysis.md · seq-cycle · jobs/worker.ts</span><span class="counter"></span></div><aside class="notes"><b>0:57 · Section 2 · SAD</b><p>Say: Follow close, claim, render and finalise in that order.</p><p>Say: The alternatives show duplicate ticks and stale workers.</p><p>Say: A retry reuses durable state instead of creating a second film.</p><p>Transition: The schema explains what makes those decisions durable.</p><p>If asked: → B2 · → B3</p></aside></section><section class="slide " id="s9" data-kind="main" data-num="9" data-main="9" data-sec="2" data-time="72" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>Keys preserve membership and the film’s exact input set.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="er-core"><figcaption>ER view · CU-B and private-group membership · PostgreSQL</figcaption><img src="uml/er-core.svg" alt="ER view · CU-B and private-group membership · PostgreSQL" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>ER view · CU-B and private-group membership · PostgreSQL</strong><code>uml/er-core.svg</code></div></figure><div class="explain"><p><b>Access.</b> Membership relates an account to a group and its role.</p><p><b>History.</b> Cycles own contributions; media jobs retain processing state.</p><p><b>Reproducibility.</b> Compilation inputs freeze which media belongs to a film.</p><p><b>Integrity.</b> Primary keys, foreign keys and uniqueness enforce the relationships.</p></div></div></div><div class="foot"><span class="source">audit/B2-design.md · er-core · PostgreSQL schema</span><span class="counter"></span></div><aside class="notes"><b>1:12 · Section 2 · SAD</b><p>Say: Membership is a relation used by access decisions.</p><p>Say: Cycles own contributions and durable media jobs.</p><p>Say: Frozen compilation inputs preserve the film’s exact input set.</p><p>Transition: Tests exercise those rules through their real boundaries.</p><p>If asked: → B4 · → B9</p></aside></section><section class="slide " id="s10" data-kind="main" data-num="10" data-main="10" data-sec="3" data-time="96" style="--accent:var(--testing)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="current" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">TESTING · SECTION 3</div><h1>Each test layer catches a different integration failure.</h1><div class="body"><table class="data testing"><thead><tr><th>Type</th><th>Tool</th><th>Count</th><th>CI lane</th><th>Blocks?</th><th>Catches</th></tr></thead><tbody><tr><td>Static</td><td>Prettier / ESLint / tsc</td><td>4 checks</td><td>Static check matrix</td><td>YES</td><td>Types, style, imports</td></tr><tr><td>Client</td><td>Jest / Testing Library</td><td>1,674</td><td>Frontend + coverage</td><td>YES</td><td>Screens, state, retry</td></tr><tr><td>Server</td><td>node:test · SQLite</td><td>1,006</td><td>Server + coverage</td><td>YES</td><td>API, privacy, cycles</td></tr><tr><td>Database</td><td>node:test · PostgreSQL 17</td><td>989 pass</td><td>PostgreSQL suite</td><td>YES</td><td>Dialect and schema</td></tr><tr><td>Repository / IaC</td><td>node:test + Python</td><td>122 + 6</td><td>Root / IaC</td><td>YES</td><td>Policy and scan gate</td></tr><tr><td>Deployment</td><td>Shell / Python fixtures</td><td>11 scripts</td><td>Cloud-free fixtures</td><td>YES</td><td>Install and rollback</td></tr><tr><td>Browser / a11y</td><td>Playwright + Axe</td><td>41 / 6 Axe</td><td>Web / browser</td><td>main</td><td>PWA, layout, keyboard</td></tr><tr><td>Real-account</td><td>Playwright · Firefox</td><td>1 flow</td><td>Local slow check</td><td>NO</td><td>Owner, member, outsider</td></tr><tr><td>Performance</td><td>Node HTTP + FFmpeg</td><td>1,200 API / 3 films</td><td>Manual performance run</td><td>NO</td><td>Latency, film, privacy</td></tr></tbody></table><div class="metric-row"><div><strong>89.64%</strong><span>Client statements · floor 70%</span></div><div><strong>92.33%</strong><span>Client lines</span></div><div><strong>85.67%</strong><span>Server lines · SQLite</span></div></div></div><div class="foot"><span class="source">audit/E-testing.md §§1–3 · local 26 Oct at f6cd896</span><span class="counter"></span></div><aside class="notes"><b>1:36 · Section 3 · TESTING</b><p>Say: Static, client, server, database and deployment checks join the required Quality gate.</p><p>Say: Browser and accessibility checks join for main; real-account and performance checks run separately.</p><p>Say: The dated coverage is eighty-nine point six four percent client statements and eighty-five point six seven server lines.</p><p>Transition: A regression test is useful when it catches an actual interaction failure.</p><p>If asked: → B6</p></aside></section><section class="slide " id="s11" data-kind="main" data-num="11" data-main="11" data-sec="3" data-time="84" style="--accent:var(--testing)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="current" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">TESTING · SECTION 3</div><h1>“Try again” must return to a usable viewfinder.</h1><div class="body"><div class="split "><div class="figure"><div class="figuretitle">Behavioural regression view · CU-A photo retry · #581</div><div class="bug-steps"><div><em>GIVEN</em><p>Photo capture fails</p></div><div><em>WHEN</em><p>User taps “Try again”</p></div><div><em>THEN</em><p>Viewfinder returns;<br>a fresh capture succeeds</p></div></div><div class="regression"><span>Before fix <b>FAIL</b></span><i>→</i><span>At f6cd896 <b>PASS</b></span></div></div><div class="explain"><p><b>Fault.</b> Retry called capture from a state where its access guard immediately returned.</p><p><b>Repair.</b> Return to the viewfinder so the user can make a fresh capture.</p><p><b>Check.</b> Audit replayed the old source: the new test failed before the fix and passed afterward.</p></div></div></div><div class="foot"><span class="source">audit/E-testing.md §§7–8 · PR #581 · replay 26 Oct</span><span class="counter"></span></div><aside class="notes"><b>1:24 · Section 3 · TESTING</b><p>Say: A visible retry button did nothing after a failed capture.</p><p>Say: The test asserts the viewfinder and a fresh capture, not the presence of a button.</p><p>Say: Replaying the old source failed the test; the current source passed.</p><p>Transition: The pipeline retains these results alongside the source and deployment artifacts.</p><p>If asked: → B3 · → B6</p></aside></section><section class="slide " id="s12" data-kind="main" data-num="12" data-main="12" data-sec="4" data-time="72" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>A commit carries tests, inventory and deployment evidence.</h1><div class="body"><div class="artifact-layout"><figure class="figure diagram" data-figure="artifact-flow"><figcaption>Artifact flow view · source → verified dev bundle</figcaption><img src="uml/artifact-flow.svg" alt="Artifact flow view · source → verified dev bundle" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Artifact flow view · source → verified dev bundle</strong><code>uml/artifact-flow.svg</code></div></figure><table class="data artifacts"><thead><tr><th>Artifact family</th><th>Content</th><th>Retained in</th></tr></thead><tbody><tr><td>Source</td><td>Issue branch → PR → protected dev</td><td>Git history / review</td></tr><tr><td>Test evidence</td><td>JUnit · Jest JSON · coverage · npm-audit.json</td><td>Quality run artifacts</td></tr><tr><td>Image inventory</td><td>Runtime + web CycloneDX SBOMs</td><td>Deploy security artifact</td></tr><tr><td>Security reports</td><td>Exact-image Trivy JSON · ZAP HTML/JSON</td><td>Deploy run artifacts</td></tr><tr><td>Identity / provenance</td><td>Manifest + bundle + signed attestation</td><td>Actions artifacts / attestations</td></tr></tbody></table></div></div><div class="foot"><span class="source">PIPELINE-ARTIFACTS.md · artifact-flow</span><span class="counter"></span></div><aside class="notes"><b>1:12 · Section 4 · DEVSECOPS</b><p>Say: Issue branches reach protected dev through a PR and green Quality.</p><p>Say: Actions retain tests, coverage, scan reports, the bundle and its identity manifest.</p><p>Say: The artifact is the built image pair, not a new build on the host.</p><p>Transition: The pipeline shows where each decision happens.</p><p>If asked: → B12</p></aside></section><section class="slide " id="s13" data-kind="main" data-num="13" data-main="13" data-sec="4" data-time="96" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>Pipeline decisions separate merge gates from host activation.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="pipeline"><figcaption>Activity view · PR checks → Deploy dev → hosted DAST</figcaption><img src="uml/pipeline.svg" alt="Activity view · PR checks → Deploy dev → hosted DAST" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Activity view · PR checks → Deploy dev → hosted DAST</strong><code>uml/pipeline.svg</code></div></figure><div class="explain"><p><b>Merge gate.</b> Aggregate Quality includes production dependency audit and parallel test lanes.</p><p><b>Deploy gate.</b> Same-commit Quality, bundle verification and exact-image Trivy precede host upload.</p><p><b>Report.</b> CodeQL, independent security jobs and post-deploy ZAP publish findings for triage.</p><p><b>Recovery.</b> Candidate health decides activation or restoration.</p></div></div></div><div class="foot"><span class="source">PIPELINE-ARTIFACTS.md · pipeline · Deploy dev 40344230832</span><span class="counter"></span></div><aside class="notes"><b>1:36 · Section 4 · DEVSECOPS</b><p>Say: Read the decision points: scope, Quality, image security and candidate health.</p><p>Say: Only aggregate Quality is branch-required; deployment has its own enforcing steps.</p><p>Say: ZAP scans hosted dev after successful activation and reports its findings.</p><p>Transition: Here are the security procedures inside those lanes.</p><p>If asked: → B5 · → B12</p></aside></section><section class="slide " id="s14" data-kind="main" data-num="14" data-main="14" data-sec="4" data-time="102" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>Security checks cover code, packages, secrets and running pages.</h1><div class="body"><table class="data security"><thead><tr><th>Procedure</th><th>Tool / scope</th><th>Result or policy</th><th>Decision</th></tr></thead><tbody><tr><td>SAST</td><td>CodeQL · JS/TS, Python, Actions</td><td>3 load-script alerts → “used in tests”</td><td>Reports / triage</td></tr><tr><td>DAST</td><td>ZAP baseline · hosted dev</td><td>0 High · 4 Medium CSP · 7 Low · 6 Info</td><td>Post-deploy report</td></tr><tr><td>SCA</td><td>npm audit + Dependabot</td><td>Production audit HIGH+ joins Quality</td><td>Blocks merge</td></tr><tr><td>Secrets</td><td>Gitleaks + push protection</td><td>Full history scan + push-time secret checks</td><td>Scan + prevention</td></tr><tr><td>IaC</td><td>Trivy config · Terraform / Docker</td><td>Exact exceptions and expiry checks</td><td>Scan workflow gate</td></tr><tr><td>Images</td><td>Trivy · exact bundled runtime + web</td><td>0 High / Critical on both images</td><td>Blocks host upload</td></tr></tbody></table><div class="takeaway">ZAP run 40344230832 · the four Medium findings concern Content Security Policy.</div></div><div class="foot"><span class="source">PIPELINE-ARTIFACTS.md · pipeline-run-40344230832/zap · CodeQL triage 26 Oct</span><span class="counter"></span></div><aside class="notes"><b>1:42 · Section 4 · DEVSECOPS</b><p>Say: CodeQL findings are triaged; three load-script alerts were closed as used in tests.</p><p>Say: ZAP reports zero High, four Medium CSP, seven Low and six Informational findings.</p><p>Say: Dependency audit, secrets controls, IaC checks and exact-image scans cover different failure modes.</p><p>Transition: The manifest ties the image results to the bytes we deployed.</p><p>If asked: → B12</p></aside></section><section class="slide " id="s15" data-kind="main" data-num="15" data-main="15" data-sec="4" data-time="90" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>The manifest binds deployed images to their scans.</h1><div class="body"><div class="split "><div class="figure"><div class="figuretitle">Real excerpt · release-manifest.json · run 40344230832</div><pre>{
  &quot;commit&quot;: &quot;aea7478bce14131b821caaa99b1185077b4a9403&quot;,
  &quot;run_id&quot;: &quot;40344230832&quot;,
  &quot;quality_run_id&quot;: &quot;40344231052&quot;,
  &quot;security_gate&quot;: &quot;pass&quot;,
  &quot;sha256&quot;: {
    &quot;rewind-release.tar&quot;:
    &quot;fef3c22a19a2e5ef8f64cba8b074dc1fc2f3f3bd9ff102831e7ea387a7696e01&quot;
  }
}</pre><div class="image-counts"><b>Runtime</b> 0 H / 0 C · 1 M · 2 Unknown<br><b>Web</b> 0 H / 0 C · 0 M</div></div><div class="explain"><p><b>Inventory.</b> CycloneDX SBOM for each bundled image.</p><p><b>Identity.</b> Commit, Quality run, image IDs, archive digests and report hashes.</p><p><b>Provenance.</b> GitHub-signed attestations bind the bundle and manifest to the workflow.</p><p><b>Verify.</b> Use gh attestation verify on the downloaded bundle.</p></div></div></div><div class="foot"><span class="source">pipeline-run-40344230832/security/release-manifest.json · manifest timestamp 26 Oct 14:59 UTC</span><span class="counter"></span></div><aside class="notes"><b>1:30 · Section 4 · DEVSECOPS</b><p>Say: These fields are copied from the real deployment manifest.</p><p>Say: Both bundled images have zero High and Critical findings.</p><p>Say: The signed attestation and SHA-256 connect workflow identity to the retained bytes.</p><p>Transition: Next, follow those verified bytes to the hosted application.</p><p>If asked: → B12</p></aside></section><section class="slide " id="s16" data-kind="main" data-num="16" data-main="16" data-sec="4" data-time="72" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>Hosted dev activates after candidate health succeeds.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="deploy-dev"><figcaption>Deployment view · GitHub Actions → hosted dev</figcaption><img src="uml/deploy-dev.svg" alt="Deployment view · GitHub Actions → hosted dev" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Deployment view · GitHub Actions → hosted dev</strong><code>uml/deploy-dev.svg</code></div></figure><div class="explain"><p><b>Access.</b> GitHub OIDC exchanges workflow identity for temporary deploy credentials.</p><p><b>Host.</b> Nginx fronts the Node application; PostgreSQL and S3 retain shared data.</p><p><b>Activate.</b> Install the candidate, check health and switch current; failure restores the prior current.</p><p><b>Public check.</b> The run finishes with the hosted /api/health check.</p></div></div></div><div class="foot"><span class="source">Deploy dev 40344230832 · deploy-dev · release-host.sh</span><span class="counter"></span></div><aside class="notes"><b>1:12 · Section 4 · DEVSECOPS</b><p>Say: OIDC gives the workflow temporary deploy credentials.</p><p>Say: The host checks the candidate before switching current.</p><p>Say: This run passed its public health check after installation.</p><p>Transition: The technical findings show why those package and runtime checks matter.</p><p>If asked: → B5 · → B12</p></aside></section><section class="slide " id="s17" data-kind="main" data-num="17" data-main="17" data-sec="4" data-time="60" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>Packaging and runtime boundaries exposed useful defects.</h1><div class="body"><table class="data findings"><thead><tr><th>Finding</th><th>Consequence</th><th>Repair / learning</th></tr></thead><tbody><tr><td>New advisory in a locked dependency tree</td><td>3 High zod findings blocked Quality</td><td>Override update + clean audit</td></tr><tr><td>Alpine removed a pinned FFmpeg package</td><td>Image build failed before scan</td><td>Update to available 8.1.3-r0 pin</td></tr><tr><td>Schema registry moved during refactoring</td><td>Bundle verifier read the old location</td><td>Read the declared schema version</td></tr><tr><td>Service worker retained SSE forwarding</td><td>Group switching exhausted streams</td><td>Browser-owned SSE + cancellation checks</td></tr><tr><td>Retry UI preserved the failed state</td><td>“Try again” returned without capture</td><td>Behavioural test + viewfinder reset</td></tr></tbody></table><div class="takeaway">Test the adapter, the built image and the whole interaction.</div></div><div class="foot"><span class="source">records/FINDINGS.md · #591 · #583 · #568 · #581</span><span class="counter"></span></div><aside class="notes"><b>1:00 · Section 4 · DEVSECOPS</b><p>Say: A locked dependency tree can still meet a new advisory, and a pinned package can disappear.</p><p>Say: Refactoring must include packaging consumers; realtime must be checked through the service worker.</p><p>Say: Whole-interaction tests caught the failed retry path.</p><p>Transition: Now follow one deployment run from Quality through artifacts and hosted health.</p><p>If asked: → B6 · → B12</p></aside></section><section class="slide " id="s18" data-kind="main" data-num="18" data-main="18" data-sec="4" data-time="228" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 4</div><h1>One run connects green Quality to hosted dev.</h1><div class="body"><div class="demo-pipeline"><div class="figure"><div class="figuretitle">CI/CD walkthrough · 26 Oct · aea7478</div><table class="data walk"><thead><tr><th>Stop</th><th>Show</th><th>Decision / output</th></tr></thead><tbody><tr><td>1</td><td>PR / Quality 40344231052</td><td>Scope classifier → parallel checks → aggregate</td></tr><tr><td>2</td><td>Required branch context</td><td>Format, lint, typecheck, and test</td></tr><tr><td>3</td><td>Security reports</td><td>CodeQL triage · audit · gitleaks · IaC</td></tr><tr><td>4</td><td>Deploy 40344230832</td><td>Same-commit gate → bundle → Trivy → attestation</td></tr><tr><td>5</td><td>Manifest, SBOM and ZAP</td><td>Exact images · signed origin · running-page findings</td></tr><tr><td>6</td><td>Hosted dev /api/health</td><td>Installed version and PostgreSQL readiness</td></tr></tbody></table></div><div class="run-clock"><div><b>02:03</b> wait for Quality</div><div><b>00:53</b> build bundle</div><div><b>00:16</b> exact-image scan</div><div><b>01:16</b> host install</div><div><b>01:44</b> ZAP scan</div></div></div><div class="demo-actions"><button data-action="pipeline">P · pipeline recording</button><button data-action="commands">C · command cards</button><span>Run 40344230832 · successful · hosted dev</span></div><div class="pipeline-overlay" hidden><div class="clip" data-clip="clips/ci-cd-40344230832.mp4"><video preload="none" playsinline></video><div class="ph"><span class="tri"></span><strong>CI/CD · run 40344230832</strong><small>clips/ci-cd-40344230832.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><button data-action="pipeline">Close recording</button></div></div><div class="foot"><span class="source">gh run view · 40344231052 / 40344230832 · 26 Oct 2026</span><span class="counter"></span></div><aside class="notes"><b>3:48 · Section 4 · DEMO</b><p>Say: Open the same-commit Quality result, then the deployment steps.</p><p>Say: Show the bundle inventory, manifest, signed provenance and ZAP report.</p><p>Say: Finish on hosted dev health, then move into the user journey.</p><p>Transition: The same hosted system is the setting for the feature demonstration.</p><p>If asked: → B5 · → B12</p></aside></section><section class="slide " id="s19" data-kind="main" data-num="19" data-main="19" data-sec="5" data-time="18" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>Follow one group from installation to a private film.</h1><div class="body"><div class="figure"><div class="figuretitle">Demonstration map · private-group journey</div><div class="journey-map"><div><em>01–04</em><h2>Enter</h2><p>Install · sign in · create · invite</p></div><div><em>05–08</em><h2>Contribute</h2><p>Photo · video · chat · reminder</p></div><div><em>09–12</em><h2>Reveal</h2><p>Close · watch · save · deny outsider</p></div></div><div class="rule">Hosted dev · owner, invited member and outsider · one feature per clip</div></div></div><div class="foot"><span class="source">audit/F1-system-demo.md §4 · videos/clips/</span><span class="counter"></span></div><aside class="notes"><b>0:18 · Section 5 · DEMO</b><p>Say: We will follow an owner and invited member, then check the outsider boundary.</p><p>Transition: Start with installing the Home Screen app.</p><p>If asked: → B1 · → B3</p></aside></section><section class="slide " id="F1" data-kind="clip" data-num="F1" data-main="19" data-sec="5" data-time="45" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>Installation keeps the app one tap away.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/01-install-to-home-screen.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F1-poster.jpg" alt="UC14 · Home Screen PWA" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC14 · Home Screen PWA</strong><small>01-install-to-home-screen.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Safari → Share → Add to Home Screen → open.</p><p><b>Observe.</b> The installed app opens in its own Home Screen window.</p><p><b>Why.</b> This is the iPhone delivery surface.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/01-install-to-home-screen.mp4 · UC14 · Home Screen PWA</span><span class="counter"></span></div><aside class="notes"><b>0:45 · Section 5 · DEMO</b><p>Say: Safari → Share → Add to Home Screen → open.</p><p>Say: The installed app opens in its own Home Screen window.</p><p>Say: This is the iPhone delivery surface.</p><p>Transition: Now sign in as Maya.</p><p>If asked: → B5</p></aside></section><section class="slide " id="F2" data-kind="clip" data-num="F2" data-main="19" data-sec="5" data-time="45" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>Sign-in returns the member to the private-group journey.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/02-sign-in.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F2-poster.jpg" alt="UC01 · account sign-in" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC01 · account sign-in</strong><small>02-sign-in.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Sign in as Maya and open her group space.</p><p><b>Observe.</b> The authenticated account returns to Rewind.</p><p><b>Design.</b> Web identity supports Cognito code + PKCE with server-side exchange.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/02-sign-in.mp4 · UC01 · account sign-in</span><span class="counter"></span></div><aside class="notes"><b>0:45 · Section 5 · DEMO</b><p>Say: Sign in as Maya and open her group space.</p><p>Say: The authenticated account returns to Rewind.</p><p>Say: Web identity supports Cognito code + PKCE with server-side exchange.</p><p>Transition: Create the group and its shared prompt.</p><p>If asked: → B5</p></aside></section><section class="slide " id="F3" data-kind="clip" data-num="F3" data-main="19" data-sec="5" data-time="60" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>A shared prompt gives the group a common starting point.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/03-create-group.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F3-poster.jpg" alt="UC02 / UC09 · create group" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC02 / UC09 · create group</strong><small>03-create-group.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Name the group, set the prompt and choose its size.</p><p><b>Observe.</b> Home shows the new group; settings retain prompt and time zone.</p><p><b>Rule.</b> The owner manages group settings.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/03-create-group.mp4 · UC02 / UC09 · create group</span><span class="counter"></span></div><aside class="notes"><b>1:00 · Section 5 · DEMO</b><p>Say: Name the group, set the prompt and choose its size.</p><p>Say: Home shows the new group; settings retain prompt and time zone.</p><p>Say: The owner manages group settings.</p><p>Transition: Invite a friend with a single-use code.</p><p>If asked: → B1</p></aside></section><section class="slide " id="F4" data-kind="clip" data-num="F4" data-main="19" data-sec="5" data-time="60" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>One accepted invitation creates one private membership.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/04-invite-and-join.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F4-poster.jpg" alt="UC03 · invite and join" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC03 · invite and join</strong><small>04-invite-and-join.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Create and share the code; the friend accepts.</p><p><b>Observe.</b> Both accounts see the same group and member list.</p><p><b>Rule.</b> Code works once and expires in 24 hours.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/04-invite-and-join.mp4 · UC03 · invite and join</span><span class="counter"></span></div><aside class="notes"><b>1:00 · Section 5 · DEMO</b><p>Say: Create and share the code; the friend accepts.</p><p>Say: Both accounts see the same group and member list.</p><p>Say: Code works once and expires in 24 hours.</p><p>Transition: The first contribution is a photo.</p><p>If asked: → B3</p></aside></section><section class="slide " id="F5" data-kind="clip" data-num="F5" data-main="19" data-sec="5" data-time="55" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>A submitted photo becomes a sealed moment.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/05-photo-with-a-look.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F5-poster.jpg" alt="UC05 · photo contribution" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC05 · photo contribution</strong><small>05-photo-with-a-look.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Take a photo, choose a look, review and submit.</p><p><b>Observe.</b> Your moments records a sealed entry.</p><p><b>Rule.</b> One photo uses one moment and three film seconds.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/05-photo-with-a-look.mp4 · UC05 · photo contribution</span><span class="counter"></span></div><aside class="notes"><b>0:55 · Section 5 · DEMO</b><p>Say: Take a photo, choose a look, review and submit.</p><p>Say: Your moments records a sealed entry.</p><p>Say: One photo uses one moment and three film seconds.</p><p>Transition: Video shares the same weekly allowance.</p><p>If asked: → B3</p></aside></section><section class="slide " id="F6" data-kind="clip" data-num="F6" data-main="19" data-sec="5" data-time="65" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>Video and photos share one enforced weekly allowance.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/06-video-and-allowance.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F6-poster.jpg" alt="UC04 / UC06 · video and allowance" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC04 / UC06 · video and allowance</strong><small>06-video-and-allowance.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Record with sound, trim and submit.</p><p><b>Observe.</b> The ledger updates moments and total seconds.</p><p><b>Rule.</b> 5 moments / 30 seconds weekly; each video ≤15 seconds.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/06-video-and-allowance.mp4 · UC04 / UC06 · video and allowance</span><span class="counter"></span></div><aside class="notes"><b>1:05 · Section 5 · DEMO</b><p>Say: Record with sound, trim and submit.</p><p>Say: The ledger updates moments and total seconds.</p><p>Say: 5 moments / 30 seconds weekly; each video ≤15 seconds.</p><p>Transition: The group can talk while the moments stay sealed.</p><p>If asked: → B3</p></aside></section><section class="slide " id="F7" data-kind="clip" data-num="F7" data-main="19" data-sec="5" data-time="55" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>Stored messages and live updates keep the group connected.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/07-group-chat.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F7-poster.jpg" alt="UC11 · group chat" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC11 · group chat</strong><small>07-group-chat.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Send a message, reply and react from the other account.</p><p><b>Observe.</b> The second view updates without a refresh.</p><p><b>Design.</b> Stored messages plus SSE delivery and reconnect.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/07-group-chat.mp4 · UC11 · group chat</span><span class="counter"></span></div><aside class="notes"><b>0:55 · Section 5 · DEMO</b><p>Say: Send a message, reply and react from the other account.</p><p>Say: The second view updates without a refresh.</p><p>Say: Stored messages plus SSE delivery and reconnect.</p><p>Transition: Next, opt into the weekly reminder.</p><p>If asked: → B8</p></aside></section><section class="slide " id="F8" data-kind="clip" data-num="F8" data-main="19" data-sec="5" data-time="50" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>Reminder permission leads to an explicit weekly choice.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/08-weekly-reminder.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F8-poster.jpg" alt="UC10 · weekly web-push reminder" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC10 · weekly web-push reminder</strong><small>08-weekly-reminder.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Open settings and enable the Sunday reminder.</p><p><b>Observe.</b> The Home Screen app requests notification permission.</p><p><b>Rule.</b> Sunday 19:00 in the group time zone; snooze seven days.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/08-weekly-reminder.mp4 · UC10 · weekly web-push reminder</span><span class="counter"></span></div><aside class="notes"><b>0:50 · Section 5 · DEMO</b><p>Say: Open settings and enable the Sunday reminder.</p><p>Say: The Home Screen app requests notification permission.</p><p>Say: Sunday 19:00 in the group time zone; snooze seven days.</p><p>Transition: Now open the completed capsule and its premiere.</p><p>If asked: → B5</p></aside></section><section class="slide " id="F9" data-kind="clip" data-num="F9" data-main="19" data-sec="5" data-time="40" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>The completed capsule is ready for its shared premiere.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/09-cycle-ends-film-ready.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F9-poster.jpg" alt="UC07 · automatic cycle closure" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC07 · automatic cycle closure</strong><small>09-cycle-ends-film-ready.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Observe.</b> A completed capsule exposes its premiere card.</p><p><b>Design.</b> The scheduler closes the cycle, queues work and opens its successor.</p><p><b>Rule.</b> The product cycle is 28 days.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/09-cycle-ends-film-ready.mp4 · UC07 · automatic cycle closure</span><span class="counter"></span></div><aside class="notes"><b>0:40 · Section 5 · DEMO</b><p>Say: A completed capsule exposes its premiere card.</p><p>Say: The scheduler closes the cycle, queues work and opens its successor.</p><p>Say: The product cycle is 28 days.</p><p>Transition: Open the group’s film.</p><p>If asked: → B2</p></aside></section><section class="slide " id="F10" data-kind="clip" data-num="F10" data-main="19" data-sec="5" data-time="80" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>The reveal turns sealed contributions into one shared film.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/10-watch-the-film.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F10-poster.jpg" alt="UC08 / UC12 · premiere and playback" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC08 / UC12 · premiere and playback</strong><small>10-watch-the-film.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Open the premiere and watch; skip between moments.</p><p><b>Observe.</b> One film combines the group’s accepted inputs.</p><p><b>Output.</b> 720 × 1280 · 30 fps · normalised audio.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/10-watch-the-film.mp4 · UC08 / UC12 · premiere and playback</span><span class="counter"></span></div><aside class="notes"><b>1:20 · Section 5 · DEMO</b><p>Say: Open the premiere and watch; skip between moments.</p><p>Say: One film combines the group’s accepted inputs.</p><p>Say: 720 × 1280 · 30 fps · normalised audio.</p><p>Transition: Archive keeps the film and offers saving.</p><p>If asked: → B2</p></aside></section><section class="slide " id="F11" data-kind="clip" data-num="F11" data-main="19" data-sec="5" data-time="55" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>Archive keeps the film available after its premiere.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/11-archive-and-save.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F11-poster.jpg" alt="UC12 / UC13 · Archive and save" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>UC12 / UC13 · Archive and save</strong><small>11-archive-and-save.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Open Archive, select the film and save it.</p><p><b>Observe.</b> The MP4 download opens as a playable file.</p><p><b>Control.</b> Members can save the film and their own moments.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/11-archive-and-save.mp4 · UC12 / UC13 · Archive and save</span><span class="counter"></span></div><aside class="notes"><b>0:55 · Section 5 · DEMO</b><p>Say: Open Archive, select the film and save it.</p><p>Say: The MP4 download opens as a playable file.</p><p>Say: Members can save the film and their own moments.</p><p>Transition: Check the outsider boundary.</p><p>If asked: → B4</p></aside></section><section class="slide " id="F12" data-kind="clip" data-num="F12" data-main="19" data-sec="5" data-time="50" style="--accent:var(--demo)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">DEMO · SECTION 5</div><h1>A spent invitation gives an outsider no group access.</h1><div class="body"><div class="split clip-layout"><div class="clip" data-clip="../videos/clips/12-outsider-denied.mp4"><video preload="none" playsinline></video><img class="poster" src="assets/F12-poster.jpg" alt="Privacy boundary · outsider account" onerror="this.style.display='none'"><div class="ph"><span class="tri"></span><strong>Privacy boundary · outsider account</strong><small>12-outsider-denied.mp4</small></div><div class="pb"><span class="tri"></span></div><div class="cb"></div></div><div class="explain"><p><b>Do.</b> Reuse the spent invitation from an outsider account.</p><p><b>Observe.</b> The invitation is rejected and the private group stays absent.</p><p><b>Boundary.</b> Private group and media reads require their access checks.</p><div class="clip-hint">P / click · play or pause<br>26 OCT 2026 · HOSTED DEV</div></div></div></div><div class="foot"><span class="source">videos/clips/12-outsider-denied.mp4 · Privacy boundary · outsider account</span><span class="counter"></span></div><aside class="notes"><b>0:50 · Section 5 · DEMO</b><p>Say: Reuse the spent invitation from an outsider account.</p><p>Say: The invitation is rejected and the private group stays absent.</p><p>Say: Private group and media reads require their access checks.</p><p>Transition: Finish with the hosted load results and the scaling mechanism.</p><p>If asked: → B6</p></aside></section><section class="slide " id="s20" data-kind="main" data-num="20" data-main="20" data-sec="5" data-time="192" style="--accent:var(--testing)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">TESTING · SECTION 5</div><h1>Load results identify the next scaling change.</h1><div class="body"><div class="perf-layout"><div><div class="figure"><div class="figuretitle">Measured hosted mixed workload · 26 Oct</div><table class="data "><thead><tr><th>VUs</th><th>p95 ms</th><th>Errors</th><th>req/s</th></tr></thead><tbody><tr><td>1</td><td>907</td><td>0.00%</td><td>0.21</td></tr><tr><td>10</td><td>537</td><td>0.00%</td><td>1.85</td></tr><tr><td>25</td><td>629</td><td>0.00%</td><td>4.63</td></tr><tr><td>50</td><td>859</td><td>0.00%</td><td>9.14</td></tr><tr><td>100</td><td>1,368</td><td>10.88%</td><td>17.31</td></tr></tbody></table></div><p class="perf-method"><b>Method:</b> Node HTTP · 1→100 VUs · 180 s steady per stage · 3–7 s think time.<br><b>Gate:</b> p95 &lt;2 s and errors &lt;1%.</p><div class="confirmation"><b>100-VU read-only confirmation</b><br>625 ms p95 · 18.42 req/s · 0 errors</div></div><div><div class="figure"><div class="figuretitle">Projected capacity · fitted operational scenario</div><svg viewBox="0 0 560 330" role="img" aria-label="Projected mean response time: one and two API hosts"><text x="45" y="25">Capacity projection · mean response (seconds)</text><path d="M55 270.0H535" stroke="#e0e3e4"/><text x="45" y="277.0" text-anchor="end">0</text><path d="M55 227.0H535" stroke="#e0e3e4"/><text x="45" y="234.0" text-anchor="end">10</text><path d="M55 184.0H535" stroke="#e0e3e4"/><text x="45" y="191.0" text-anchor="end">20</text><path d="M55 141.0H535" stroke="#e0e3e4"/><text x="45" y="148.0" text-anchor="end">30</text><path d="M55 98.0H535" stroke="#e0e3e4"/><text x="45" y="105.0" text-anchor="end">40</text><path d="M55 55.0H535" stroke="#e0e3e4"/><text x="45" y="62.0" text-anchor="end">50</text><polyline points="85,266.6503 225,236.2579 365,181.48880000000003 505,71.78720000000001" fill="none" stroke="#ba501c" stroke-width="4"/><circle cx="85" cy="266.6503" r="5" fill="#ba501c"/><circle cx="225" cy="236.2579" r="5" fill="#ba501c"/><circle cx="365" cy="181.48880000000003" r="5" fill="#ba501c"/><circle cx="505" cy="71.78720000000001" r="5" fill="#ba501c"/><polyline points="85,268.1166 225,262.9437 365,236.2579 505,181.48880000000003" fill="none" stroke="#2c64a0" stroke-width="4"/><circle cx="85" cy="268.1166" r="5" fill="#2c64a0"/><circle cx="225" cy="262.9437" r="5" fill="#2c64a0"/><circle cx="365" cy="236.2579" r="5" fill="#2c64a0"/><circle cx="505" cy="181.48880000000003" r="5" fill="#2c64a0"/><text x="85" y="301" text-anchor="middle">100</text><text x="225" y="301" text-anchor="middle">250</text><text x="365" y="301" text-anchor="middle">500</text><text x="505" y="301" text-anchor="middle">1000</text><text x="130" y="328" fill="#ba501c">1 host</text><text x="260" y="328" fill="#2c64a0">2 hosts</text><text x="515" y="328" text-anchor="end">active users</text></svg></div><p><b>Observed.</b> The mixed run’s 100-VU error interval overlaps deployment.</p><p><b>Scale.</b> Separate media work; remove synchronous database serialization; coordinate shared state.</p><p><b>Maintain.</b> The same pipeline checks the next change.</p></div></div></div><div class="foot"><span class="source">load-test/METHODOLOGY.md · RESULTS.md · 26 Oct hosted dev</span><span class="counter"></span></div><aside class="notes"><b>3:12 · Section 5 · TESTING</b><p>Say: The mixed run passed through fifty virtual users; the hundred-user stage had deployment-overlap errors.</p><p>Say: A separate read-only hundred-user confirmation returned six hundred twenty-five milliseconds p95 with zero errors.</p><p>Say: The capacity chart is a projection; the next changes target synchronous persistence and competing media work.</p><p>Transition: We can take questions using the backup map.</p><p>If asked: → B6 · → B11 · → B12</p></aside></section><section class="slide " id="B1" data-kind="back" data-num="B1" data-main="20" data-sec="2" data-time="0" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>Analysis separates interaction, coordination and state.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="bce-cycle"><figcaption>Analysis class view · CU-B · boundary / control / entity</figcaption><img src="uml/bce-cycle.svg" alt="Analysis class view · CU-B · boundary / control / entity" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Analysis class view · CU-B · boundary / control / entity</strong><code>uml/bce-cycle.svg</code></div></figure><div class="explain"><p><b>Boundary.</b> Receives the member’s view of cycle and film status.</p><p><b>Control.</b> Coordinates closure, compilation and reveal.</p><p><b>Entity.</b> Retains membership, cycle, job and film-input state.</p></div></div></div><div class="foot"><span class="source">audit/B1-analysis.md · bce-cycle</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 2 · SAD</b><p>Say: These are analysis responsibilities, then refined by the mapping on main frame six.</p><p>Transition: Return to the main analysis-to-design mapping.</p><p>If asked: → B2</p></aside></section><section class="slide " id="B2" data-kind="back" data-num="B2" data-main="20" data-sec="2" data-time="0" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>Durable state survives interrupted compilation.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="state-cycle"><figcaption>State view · CU-B · cycle lifecycle</figcaption><img src="uml/state-cycle.svg" alt="State view · CU-B · cycle lifecycle" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>State view · CU-B · cycle lifecycle</strong><code>uml/state-cycle.svg</code></div></figure><div class="explain"><p><b>Lifecycle.</b> Collecting leads into processing and the released film states.</p><p><b>Retry.</b> Durable jobs preserve unfinished work across process stops.</p><p><b>Fence.</b> An old generation cannot finalise after ownership changes.</p></div></div></div><div class="foot"><span class="source">audit/B1-analysis.md · state-cycle</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 2 · SAD</b><p>Say: The stored state and current claim determine what can happen next.</p><p>Transition: Return to the CU-B sequence.</p><p>If asked: → B4</p></aside></section><section class="slide " id="B3" data-kind="back" data-num="B3" data-main="20" data-sec="2" data-time="0" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>Capture acceptance checks identity, allowance and media.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="seq-capture"><figcaption>Sequence view · CU-A · contribute a photo</figcaption><img src="uml/seq-capture.svg" alt="Sequence view · CU-A · contribute a photo" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Sequence view · CU-A · contribute a photo</strong><code>uml/seq-capture.svg</code></div></figure><div class="explain"><p><b>Reserve.</b> Check the member and allowance before acceptance.</p><p><b>Upload.</b> Validate media bytes and processing metadata.</p><p><b>Accept.</b> Retain the sealed contribution with its budget effect.</p></div></div><div class="alternate-view" data-view="seq-capture-accept" hidden><img src="uml/seq-capture-accept.svg" alt="UML view · seq capture accept"></div><div class="figure-switches"><button data-alt-view="seq-capture-process">seq capture process</button><button data-alt-view="seq-capture-commit">seq capture commit</button><button data-alt-view="seq-capture-accept">seq capture accept</button><button data-default-view="true">Overview</button></div><div class="alternate-view" data-view="seq-capture-commit" hidden><img src="uml/seq-capture-commit.svg" alt="UML view · seq capture commit"></div><div class="alternate-view" data-view="seq-capture-process" hidden><img src="uml/seq-capture-process.svg" alt="UML view · seq capture process"></div></div><div class="foot"><span class="source">audit/B1-analysis.md · seq-capture</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 2 · SAD</b><p>Say: Acceptance crosses the server boundary and updates durable allowance state.</p><p>Transition: Return to the feature clip.</p><p>If asked: → B6</p></aside></section><section class="slide " id="B4" data-kind="back" data-num="B4" data-main="20" data-sec="2" data-time="0" style="--accent:var(--sad)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SAD · SECTION 2</div><h1>Relational keys make the private film traceable.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="er-core"><figcaption>ER view · CU-B · PostgreSQL schema detail</figcaption><img src="uml/er-core.svg" alt="ER view · CU-B · PostgreSQL schema detail" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>ER view · CU-B · PostgreSQL schema detail</strong><code>uml/er-core.svg</code></div></figure><div class="explain"><p><b>Choice.</b> Transactions, relational integrity and managed backup support the group workflow.</p><p><b>Compared.</b> SQLite remains useful locally; a document store would still need cross-record consistency.</p><p><b>Trace.</b> Frozen compilation inputs link the finished film to its source set.</p></div></div></div><div class="foot"><span class="source">audit/B2-design.md · ADR-0003 · er-core</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 2 · SAD</b><p>Say: PostgreSQL supports the transactional relationships this workflow needs.</p><p>Transition: Return to the schema or Archive frame.</p><p>If asked: → B9</p></aside></section><section class="slide " id="B5" data-kind="back" data-num="B5" data-main="20" data-sec="4" data-time="0" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>The deployment view names each runtime boundary.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="deploy-dev"><figcaption>Deployment view · hosted dev · application and managed services</figcaption><img src="uml/deploy-dev.svg" alt="Deployment view · hosted dev · application and managed services" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Deployment view · hosted dev · application and managed services</strong><code>uml/deploy-dev.svg</code></div></figure><div class="explain"><p><b>Edge.</b> CloudFront and nginx route the public web/API entry.</p><p><b>Runtime.</b> Node and media processing run on the host.</p><p><b>Services.</b> PostgreSQL, private S3, Cognito and web push keep explicit interfaces.</p></div></div></div><div class="foot"><span class="source">audit/B2-design.md · deploy-dev</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 4 · DEVSECOPS</b><p>Say: The diagram places the logical components on their hosted runtime and service boundaries.</p><p>Transition: Return to the CI/CD run.</p><p>If asked: → B12</p></aside></section><section class="slide " id="B6" data-kind="back" data-num="B6" data-main="20" data-sec="3" data-time="0" style="--accent:var(--testing)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="current" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">TESTING · SECTION 3</div><h1>Coverage and enforcement answer different questions.</h1><div class="body"><table class="data "><thead><tr><th>Coverage</th><th>Local 26 Oct</th><th>CI 20 Oct</th><th>Policy</th></tr></thead><tbody><tr><td>Client statements</td><td>89.64%</td><td>89.66%</td><td>70% statement floor</td></tr><tr><td>Client branches</td><td>85.68%</td><td>85.66%</td><td>Reported</td></tr><tr><td>Client functions</td><td>89.55%</td><td>89.61%</td><td>Reported</td></tr><tr><td>Client lines</td><td>92.33%</td><td>92.33%</td><td>Reported</td></tr><tr><td>Server lines</td><td>85.67%</td><td>85.50%</td><td>Reported</td></tr><tr><td>Server branches</td><td>85.62%</td><td>85.66%</td><td>Reported</td></tr><tr><td>Server functions</td><td>85.05%</td><td>86.41%</td><td>Reported</td></tr></tbody></table><div class="backup-bottom"><p><b>Cases.</b> 1,674 frontend; 1,006 server; 122 root; 41 browser including 6 Axe.</p><p><b>Privacy.</b> Route contracts and outsider tests exercise group, budget, chat and private media denials.</p><p><b>Performance.</b> Local: 1,200 requests; 3 × 25-clip films in 4.9–8.1 seconds.</p></div></div><div class="foot"><span class="source">audit/E-testing.md §§1–3,6 · f6cd896</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 3 · TESTING</b><p>Say: Client statements have an enforced floor; server coverage is retained as a report.</p><p>Transition: Return to the testing table.</p><p>If asked: → B11</p></aside></section><section class="slide " id="B7" data-kind="back" data-num="B7" data-main="20" data-sec="2" data-time="0" style="--accent:var(--sdp)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SDP · SECTION 2</div><h1>Storage changes behind Strategy and Adapter roles.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="pattern-storage"><figcaption>Pattern class view · storage · Strategy + Adapter</figcaption><img src="uml/pattern-storage.svg" alt="Pattern class view · storage · Strategy + Adapter" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Pattern class view · storage · Strategy + Adapter</strong><code>uml/pattern-storage.svg</code></div></figure><div class="explain"><p><b>Problem.</b> Local disk and hosted S3 use different protocols.</p><p><b>Candidates.</b> Conditionals at call sites; subclassing; interface with injected implementations.</p><p><b>Chosen.</b> MediaStore strategy with concrete storage adapters.</p></div></div></div><div class="foot"><span class="source">audit/B2-design.md · pattern-storage</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 2 · SDP</b><p>Say: The interface isolates the storage choice and each adapter handles its protocol.</p><p>Transition: Return to the architecture decision.</p><p>If asked: → B9</p></aside></section><section class="slide " id="B8" data-kind="back" data-num="B8" data-main="20" data-sec="2" data-time="0" style="--accent:var(--sdp)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SDP · SECTION 2</div><h1>Observer distributes chat updates alongside stored history.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="pattern-observer"><figcaption>Pattern class view · chat · Observer / RealtimeHub</figcaption><img src="uml/pattern-observer.svg" alt="Pattern class view · chat · Observer / RealtimeHub" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Pattern class view · chat · Observer / RealtimeHub</strong><code>uml/pattern-observer.svg</code></div></figure><div class="explain"><p><b>Problem.</b> Several active screens need the same new message.</p><p><b>Candidates.</b> Polling, direct callbacks, publish/subscribe.</p><p><b>Chosen.</b> RealtimeHub observers plus stored messages and reconnect.</p></div></div></div><div class="foot"><span class="source">audit/B2-design.md · pattern-observer</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 2 · SDP</b><p>Say: RealtimeHub distributes live updates; stored messages support replay.</p><p>Transition: Return to the chat clip.</p><p>If asked: → B5</p></aside></section><section class="slide " id="B9" data-kind="back" data-num="B9" data-main="20" data-sec="2" data-time="0" style="--accent:var(--sdp)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="current" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">SDP · SECTION 2</div><h1>The persistence adapter preserves a common data-access contract.</h1><div class="body"><div class="split "><figure class="figure diagram" data-figure="pattern-persistence"><figcaption>Pattern class view · persistence · PostgresDatabase Adapter</figcaption><img src="uml/pattern-persistence.svg" alt="Pattern class view · persistence · PostgresDatabase Adapter" onload="this.parentElement.classList.add('loaded')" onerror="this.style.display='none'"><div class="fig-placeholder"><span>UML FIGURE</span><strong>Pattern class view · persistence · PostgresDatabase Adapter</strong><code>uml/pattern-persistence.svg</code></div></figure><div class="explain"><p><b>Problem.</b> Hosted PostgreSQL differs from the local database API.</p><p><b>Candidates.</b> Rewrite callers; spread dialect branches; central adapter.</p><p><b>Chosen.</b> PostgresDatabase centralises translation and transaction behaviour.</p></div></div></div><div class="foot"><span class="source">audit/B2-design.md · pattern-persistence</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 2 · SDP</b><p>Say: The adapter centralises dialect work; its synchronous bridge also informs the scaling discussion.</p><p>Transition: Return to the capacity model.</p><p>If asked: → B4 · → B11</p></aside></section><section class="slide " id="B10" data-kind="back" data-num="B10" data-main="20" data-sec="1" data-time="0" style="--accent:var(--pm)"><div class="section-progress" aria-label="Five section progress"><span class="current" title="PM"></span><span class="" title="SAD / SDP"></span><span class="" title="TESTING"></span><span class="" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">PM · SECTION 1</div><h1>Agile records retain scope changes and equal effort.</h1><div class="body"><div class="split "><figure class="figure chart"><figcaption>Burndown record · Sprint 3 · scope and remaining issues</figcaption><img src="assets/burndown-sprint-3.png" alt="Burndown record · Sprint 3 · scope and remaining issues"></figure><div class="explain"><p><b>Effort.</b> Five members, 20% each; 10 planned person-days per member.</p><p><b>Burndown.</b> Sprint 3: scope 18→45; open 3→5. Sprint 2: scope 9→135; open 3→9.</p><p><b>Velocity.</b> Issues closed: 44 / 100 / 145 / 30. PRs merged: 11 / 36 / 132 / 34.</p><p><b>Delivery register.</b> 26 Oct: #230, #362, #504, #515, #527, #587, #588.</p></div></div><div class="chart-switches"><button data-chart="assets/burndown-sprint-0.png">Sprint 0</button><button data-chart="assets/burndown-sprint-1.png">Sprint 1</button><button data-chart="assets/burndown-sprint-2.png">Sprint 2</button><button data-chart="assets/burndown-sprint-3.png">Sprint 3</button><button data-chart="assets/velocity.png">Velocity</button></div></div><div class="foot"><span class="source">records/AGILE.md · TEAM.md · data/velocity.csv · burndown CSVs</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 1 · PM</b><p>Say: Burndown replays milestone and close events; velocity counts closures in each sprint window.</p><p>Transition: Return to the PM summary.</p><p>If asked: → B6</p></aside></section><section class="slide " id="B11" data-kind="back" data-num="B11" data-main="20" data-sec="5" data-time="0" style="--accent:var(--testing)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="done" title="DEVSECOPS"></span><span class="current" title="DEMO"></span></div><div class="kicker">TESTING · SECTION 5</div><h1>The capacity curve follows the closed-user workload.</h1><div class="body"><div class="split "><figure class="figure chart"><figcaption>Performance view · measured and projected mean response</figcaption><img src="assets/measured-vs-projected.png" alt="Performance view · measured and projected mean response"></figure><div class="explain"><p><b>Fit.</b> S = 51.039 ms/request; L = 341.8 ms; Z = 5 s.</p><p><b>Equations.</b> U = λS; R = L + S/(1−U); λ = N/(Z+R).</p><p><b>Projected.</b> 1 host ≈19.6 req/s ceiling; 2 ideal balanced hosts ≈39.2 req/s.</p><p><b>Next step.</b> Asynchronous persistence, media-worker separation and coordinated shared state.</p></div></div></div><div class="foot"><span class="source">load-test/RESULTS.md · results/capacity-model.json</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 5 · TESTING</b><p>Say: The model solves throughput and response time together as users wait between actions.</p><p>Transition: Return to the measured performance table.</p><p>If asked: → B9</p></aside></section><section class="slide " id="B12" data-kind="back" data-num="B12" data-main="20" data-sec="4" data-time="0" style="--accent:var(--devsecops)"><div class="section-progress" aria-label="Five section progress"><span class="done" title="PM"></span><span class="done" title="SAD / SDP"></span><span class="done" title="TESTING"></span><span class="current" title="DEVSECOPS"></span><span class="" title="DEMO"></span></div><div class="kicker">DEVSECOPS · SECTION 4</div><h1>Retained artifacts make the deployment independently inspectable.</h1><div class="body"><table class="data "><thead><tr><th>File / output</th><th>Question it answers</th></tr></thead><tbody><tr><td>quality-test-results-root · server/frontend coverage</td><td>Which behaviours and coverage were exercised?</td></tr><tr><td>npm-audit.json · gitleaks.sarif · iac-full.json</td><td>Which dependency, secret and configuration findings were reported?</td></tr><tr><td>sbom-runtime.cdx.json · sbom-web.cdx.json</td><td>Which components are inside the image pair?</td></tr><tr><td>trivy-runtime.json · trivy-web.json</td><td>Which findings belong to those exact images?</td></tr><tr><td>release-manifest.json · rewind-release.tar</td><td>Which commit, bytes and report hashes travelled together?</td></tr><tr><td>Signed provenance · gh attestation verify</td><td>Which workflow produced the retained subjects?</td></tr><tr><td>ZAP report_html.html · report_json.json</td><td>Which running-page findings were observed?</td></tr></tbody></table><pre class="command">gh attestation verify --repo Collaboration95/rewind-app rewind-release.tar</pre></div><div class="foot"><span class="source">PIPELINE-ARTIFACTS.md · pipeline-run-40344230832/</span><span class="counter"></span></div><aside class="notes"><b>Q&A · Section 4 · DEVSECOPS</b><p>Say: The manifest links identity and report hashes; provenance binds the retained subjects to the build.</p><p>Transition: Return to the CI/CD walkthrough.</p><p>If asked: → B5</p></aside></section></div><div id="notes"></div><div id="ov"></div><div id="black"></div><div id="hud"></div><script>
(function(){
var W=1280,H=720;
var stage=document.getElementById('stage');
var slides=Array.prototype.slice.call(document.querySelectorAll('.slide'));
var N=slides.length;
var mainCount=slides.filter(function(s){return s.dataset.kind==='main'}).length;
slides.forEach(function(s,i){s.querySelector('.counter').textContent=s.dataset.kind==='main'?s.dataset.num+' / '+mainCount:s.dataset.kind==='clip'?s.dataset.num+' · feature / 12':s.dataset.num+' · backup';s.dataset.physical=i+1});
var bar=document.getElementById('bar'),notes=document.getElementById('notes'),ov=document.getElementById('ov'),blk=document.getElementById('black'),hud=document.getElementById('hud');
var cur=-1,buf='',hudT=0;
function toggleFigureZoom(src){var old=document.getElementById('figure-zoom');if(old){old.remove();return}var im=src||slides[cur].querySelector('.alternate-view:not([hidden]) img,.diagram img');if(!im)return;var z=document.createElement('div');z.id='figure-zoom';z.innerHTML='<button class=zoom-close>Z / click · close figure</button><div class=zoom-scroll><img></div>';z.querySelector('img').src=im.src;z.querySelector('img').alt=im.alt;z.querySelector('button').onclick=function(){z.remove()};document.body.appendChild(z)}
document.addEventListener('dblclick',function(e){if(e.target.matches('.diagram img,.alternate-view img'))toggleFigureZoom(e.target)});
function toggleCommands(){var s=slides[cur];var c=s.querySelector('.commands');if(c){c.remove();return}c=document.createElement('div');c.className='commands';c.innerHTML="<h2>CI/CD demonstration \u00b7 authenticated gh CLI</h2><pre>gh run view 40344231052 -R Collaboration95/rewind-app\ngh api repos/Collaboration95/rewind-app/branches/dev/protection\ngh run view 40344230832 -R Collaboration95/rewind-app\ngh api repos/Collaboration95/rewind-app/actions/runs/40344230832/artifacts\ngh attestation verify --repo Collaboration95/rewind-app rewind-release.tar</pre><p>Open saved files: release-manifest.json \u2192 SBOM \u2192 Trivy JSON \u2192 ZAP HTML.</p><p>Hosted dev: https://d2m6kz76y4kuvm.cloudfront.net/api/health</p><button data-action=\"commands\">C \u00b7 close command cards</button>";s.querySelector('.body').appendChild(c)}
document.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;if(b.dataset.defaultView){slides[cur].querySelectorAll('.alternate-view').forEach(function(x){x.hidden=true})}if(b.dataset.altView){slides[cur].querySelectorAll('.alternate-view').forEach(function(x){x.hidden=x.dataset.view!==b.dataset.altView})}if(b.dataset.action==='commands'){toggleCommands()}if(b.dataset.action==='pipeline'){var c=slides[cur].querySelector('.pipeline-overlay');c.hidden=!c.hidden;if(c.hidden)c.querySelector('video').pause();else initClip(c.querySelector('.clip'))}if(b.dataset.chart){var im=slides[cur].querySelector('.chart img');im.src=b.dataset.chart;im.alt=b.textContent+' agile chart';slides[cur].querySelector('.chart figcaption').textContent='Agile record · '+b.textContent}});

function fit(){var availH=window.innerHeight-(notes.classList.contains('on')?230:0);var s=Math.min(window.innerWidth/W,availH/H);var x=(window.innerWidth-W*s)/2,y=(availH-H*s)/2;stage.style.transform='translate('+x+'px,'+y+'px) scale('+s+')'}
function clipOf(i){return slides[i].querySelector('.clip')}
function initClip(c){if(!c||c._init)return;c._init=1;var v=c.querySelector('video');
v.addEventListener('loadeddata',function(){c.classList.add('ready')});
v.addEventListener('error',function(){c.classList.remove('ready')});
v.addEventListener('play',function(){c.classList.add('playing')});
v.addEventListener('pause',function(){c.classList.remove('playing')});
v.addEventListener('ended',function(){c.classList.remove('playing')});
v.addEventListener('timeupdate',function(){if(v.duration&&c.querySelector('.cb'))c.querySelector('.cb').style.width=(100*v.currentTime/v.duration)+'%'});
c.addEventListener('click',function(e){e.stopPropagation();toggleClip()});
v.preload='auto';v.src=c.dataset.clip;}
function toggleClip(){var c=cur>=0&&clipOf(cur);if(!c||!c.classList.contains('ready'))return;var v=c.querySelector('video');if(v.paused)v.play();else v.pause()}
function go(i,noHash){if(i<0||i>=N)return;
if(cur>=0&&cur!==i){slides[cur].classList.remove('active');var oc=clipOf(cur);if(oc&&oc._init)oc.querySelector('video').pause()}
cur=i;
slides.forEach(function(s,j){s.classList.toggle('active',j===i)});
initClip(clipOf(i));
var isMain=slides[i].dataset.kind==='main'||slides[i].dataset.kind==='clip';
bar.style.width=(isMain?(100*Number(slides[i].dataset.main)/mainCount):100)+'%';bar.style.background=isMain?'#2563EB':'#64748B';
var a=slides[i].querySelector('aside.notes');notes.innerHTML=a?a.innerHTML:'';
if(!noHash&&location.hash!=='#'+(i+1))history.replaceState(null,'','#'+(i+1));}
function next(){if(cur<N-1)go(cur+1)}
function prev(){if(cur>0)go(cur-1)}
function showHud(t){hud.textContent=t;hud.style.display=t?'block':'none'}
function buildOv(){if(ov._built)return;ov._built=1;slides.forEach(function(s,i){var th=document.createElement('div');th.className='th';th.dataset.i=i;var inn=document.createElement('div');inn.className='in';var cl=s.cloneNode(true);cl.removeAttribute('id');cl.classList.remove('active');inn.appendChild(cl);th.appendChild(inn);var n=document.createElement('div');n.className='n';n.textContent=s.dataset.num;th.appendChild(n);ov.appendChild(th)});
}
function sizeOv(){var ths=ov.querySelectorAll('.th');if(!ths.length)return;var w=ths[0].clientWidth;ths.forEach(function(t){t.firstChild.style.transform='scale('+(w/W)+')'})}
function toggleOv(on){buildOv();var want=(on===undefined)?!ov.classList.contains('on'):on;ov.classList.toggle('on',want);if(want){sizeOv();ov.querySelectorAll('.th').forEach(function(t,i){t.classList.toggle('cur',i===cur)});var c=ov.querySelector('.th.cur');if(c)c.scrollIntoView({block:'center'})}}
function fromHash(){var id=(location.hash||'').slice(1);var found=slides.findIndex(function(s){return s.id===id});if(found>=0)return found;var n=parseInt((location.hash||'').slice(1),10);return (n>=1&&n<=N)?n-1:0}
document.addEventListener('keydown',function(e){if(e.metaKey||e.ctrlKey||e.altKey)return;var k=e.key;
if(/^[0-9]$/.test(k)){buf+=k;showHud('go to '+buf);clearTimeout(hudT);hudT=setTimeout(function(){buf='';showHud('')},3000);return}
if(k==='Enter'&&buf){var n=parseInt(buf,10);buf='';showHud('');if(n>=1&&n<=N){toggleOv(false);go(n-1)}e.preventDefault();return}
if(k==='Escape'){buf='';showHud('');toggleOv(false);blk.classList.remove('on');return}
if(blk.classList.contains('on')&&k.toLowerCase()!=='b')return;
if(k==='ArrowRight'||k==='d'||k==='D'){e.preventDefault();if(!ov.classList.contains('on'))next()}
else if(k==='ArrowLeft'||k==='a'||k==='A'){e.preventDefault();if(!ov.classList.contains('on'))prev()}
else if(k==='n'||k==='N'){notes.classList.toggle('on');fit()}
else if(k==='o'||k==='O'){toggleOv()}
else if(k==='b'||k==='B'){blk.classList.toggle('on')}
else if(k==='f'||k==='F'){if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen&&document.documentElement.requestFullscreen()}
else if(k==='p'||k==='P'){var po=slides[cur].querySelector('.pipeline-overlay');if(po&&po.hidden)po.hidden=false;initClip(clipOf(cur));toggleClip()}
else if(k==='c'||k==='C'){toggleCommands()}
else if(k==='z'||k==='Z'){toggleFigureZoom()}
});
window.addEventListener('resize',function(){fit();if(ov.classList.contains('on'))sizeOv()});
window.addEventListener('hashchange',function(){var i=fromHash();if(i!==cur)go(i,true)});
ov.addEventListener('click',function(e){var t=e.target.closest('.th');if(t){toggleOv(false);go(Number(t.dataset.i))}});
fit();go(fromHash(),true);
window.deck={go:go,slides:slides,fit:fit};

})();
</script></body></html>